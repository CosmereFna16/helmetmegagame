generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharacterStatus {
  ALIVE
  DEAD
  CURSED
}

enum ActionType {
  EFFORT
  MOVE
}

enum ActionStatus {
  PENDING_TYPE
  PENDING_OPPOSED
  PENDING
  CONFIRMED
  // Legacy terminal state from the pre-rework adjudication flow. No longer
  // written by new code — a CONFIRMED Move's GM-facing progress now lives on
  // moveReviewStatus instead. Kept in the enum (rather than removed) so old
  // rows don't need a risky Postgres enum-value migration.
  ADJUDICATED
}

// Routine/Gambit replaces the old Effort/Move split (ActionType, below) —
// Gambit is the only kind that rolls a d6. ActionType/Action.type stay in
// the schema for historical rows but are no longer meaningfully set beyond
// a constant "MOVE" going forward.
enum MoveKind {
  ROUTINE
  GAMBIT
}

// GM-facing spreadsheet status, tracked independently of ActionStatus (which
// only covers the player-side submission pipeline up through CONFIRMED).
enum MoveReviewStatus {
  OPEN
  WAITING_FOR_OPPONENTS
  IN_PROGRESS
  SOLVED
  // Where every Routine lands the moment it's confirmed: its effects have
  // already been pushed, so it needs a GM only if one disagrees. Rendered as
  // plain body text, same as OPEN — neither is a state worth shouting about.
  PASSED
}

enum TurnPhase {
  DAWN
  DUSK
}

enum TurnStatus {
  OPEN
  RESOLVED
}

enum Weather {
  CLEAR
  FOG
  RAIN
  STORM
  MIGRATION
}

enum TagSource {
  POINT_BUY
  DESIRE_REWARD
  GM_GRANT
  LEADER_GRANT
  EVENT
}

// A Request is a player-initiated change that took effect IMMEDIATELY and is
// reviewed by a GM afterwards, rather than waiting on approval first. See
// docs/systemdocs/REQUESTS.md. Adding a type here is one of the two places a
// new request kind touches (the other is web/lib/requestEffects.js).
enum RequestType {
  FULFILL_DESIRE
  ADD_TAG
  REMOVE_TAG
  CONSUME_TAG
  TRANSFER_RESOURCES
  TRANSFER_TAG
  SET_MOOD
  DONATE_BLOOD
  FEED_PERSON
  CHANGE_WORST_FEAR
  FULFILL_WORST_FEAR
  HEAL_CHARACTER
}

// PASSED is the default and means "not yet touched by a GM" — the request
// stands as the player made it. EDITED/UNDONE are both terminal GM verdicts.
enum RequestStatus {
  PASSED
  EDITED
  UNDONE
}

enum DesireStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

// What an ArchiveEntry row records. MESSAGE is a proxied character message;
// everything else is a system event written by game logic, so the two
// interleave chronologically in /archive and the transcript reads as a diary
// rather than a chat log with no context.
enum ArchiveKind {
  MESSAGE
  TURN_START
  CHARACTER_CREATED
  DEATH
  DESIRE_FULFILLED
  WORST_FEAR_FULFILLED
  LIFEWEB
  TRAVEL
}

model GameConfig {
  id                         Int      @id @default(1)
  lifewebBlood               Int      @default(100)
  lifewebDecayPerTurn        Int      @default(10)
  nextWeather                Weather?
  nextTurnNote               String?
  turnsAnnouncementChannelId String?
  turnsAnnouncementMessageId String?

  // Gates the whole Dawn message-wipe system (db/lib/dawnWipe.js) — off by
  // default so nothing gets swept until a GM explicitly opts in from the
  // Dev Panel.
  messageWipeEnabled Boolean @default(false)

  // Capitalizes the first letter of each sentence in Tupper-proxied messages
  // before they're reposted (bot/src/lib/textCorrection.js) — on by default,
  // purely cosmetic, never touches anything but sentence-start casing.
  tupperAutocorrectEnabled Boolean @default(true)

  // Gates the "{base} | Character Name" Discord nickname sync
  // (bot/src/lib/nickname.js, web/lib/discordGuild.js#syncCharacterNickname)
  // — off by default so nobody's nickname is touched until a GM opts in.
  nicknameSyncEnabled Boolean @default(false)

  // Whether players can reach /archive. GMs always can. Off by default and
  // meant to stay off until the game ends: the archive shows every location
  // regardless of where a character was, and renders a concealed message as
  // "Alias (Real Name)" — so turning it on mid-game retroactively unmasks
  // every /conceal ever used and hands everyone the whole map's history.
  // Effectively a one-way door; the Dev Panel confirms before flipping it.
  archiveVisible Boolean @default(false)

  // Whether arrivals/departures are recorded as TRAVEL rows in the archive.
  // Off by default: it's what makes a location read like a story, and also
  // what drowns the transcript at 100+ players (two rows per character per
  // turn before anyone says a word).
  archiveTravelEvents Boolean @default(false)

  // The single, always-present "location" channel used for the zone/location
  // travel picker (see bot/src/lib/location.js) — same tracked-message
  // pattern as turnsAnnouncement* above.
  locationPromptChannelId String?
  locationPromptMessageId String?

  // Multiplier applied to every rate in db/lib/production.js's
  // PRODUCTION_RATES table — read live by /hunt, /fish, /farm and /herd
  // (bot/src/lib/labor.js). docs/documents.yaml renders its numbers through
  // live {resource:...} bubbles, so nothing needs regenerating when this
  // changes. See docs/systemdocs/PRODUCTION.md.
  productionCoefficient Float @default(1)

  // Base point-buy budget every new character starts with, before the
  // role's own `extra_starting_points` and the Cursed penalty are applied
  // (see web/lib/characterCreation.js#computeBudget). Editable live from
  // the Dev Panel so it can be tuned right up to launch.
  startingTagPoints Int @default(12)

  // Master switch for the game being open to players at all. While false,
  // nobody can create a character — the game has not launched. Turning it on
  // is not by itself enough: a player also has to hold DISCORD_PLAYER_ROLE_ID
  // (see web/lib/discordGuild.js#isApprovedPlayer), so the two together are
  // "the doors are open" AND "you are on the list". Deliberately off by
  // default, same posture as messageWipeEnabled.
  //
  // Note this gates character creation only. /documents stays readable
  // either way, so players can read the rules before launch.
  openToPlayers Boolean @default(false)

  // Master switch for letting a player upload their own profile picture.
  // Off means AvatarField's file input doesn't render and
  // updateCharacterProfile ignores a posted `avatar` field even if one
  // arrives anyway — everyone falls through to their letter plaque (see
  // "Character proxying" in CLAUDE.md). Existing Character.avatarData is
  // untouched either way; this only gates new uploads. Deliberately off by
  // default, same posture as messageWipeEnabled/openToPlayers.
  avatarUploadsEnabled Boolean @default(false)

  // Master switch for the in-app portrait maker (docs/systemdocs/PORTRAITS.md).
  // Off means the "Customize Appearance" button doesn't render and
  // setPortraitAvatar refuses whatever the client posts — the same
  // presentation/lock split as avatarUploadsEnabled above. Off by default.
  portraitMakerEnabled Boolean @default(false)

  // Reveals the portrait parts the catalog marks `fantasy`: pointed ears,
  // horns, antlers, and unnatural hair and eye colours. Ravenheart is low
  // fantasy and human-only, so these are hidden rather than deleted — a GM
  // running something stranger flips this and they appear. Off by default, and
  // re-checked server-side: a portrait already wearing horns when it is turned
  // back off keeps them until its owner next saves.
  portraitFantasyPartsEnabled Boolean @default(false)

  // How many tags a character may have equipped at once. Enforced inside the
  // transaction that flips CharacterTag.equipped, so two tabs racing on the
  // last slot cannot both win. Editable live from the Dev Panel, same posture
  // as startingTagPoints above.
  equipSlots Int @default(6)

  // Expected total number of players, the denominator for every role's seat
  // cap: a role with `weight: 6` in docs/roles.yaml gets
  // round(6 * playerCount / 100) seats. Raising this mid-signup widens every
  // capped role proportionally without touching the YAML.
  playerCount Int @default(100)

  // The two hardcoded narrowcast channels (#radio, #intercom) — see
  // db/lib/narrowcastAccess.js. Provisioned once by
  // npm run db:sync-narrowcast-channels; never touched again after that.
  radioChannelId    String?
  intercomChannelId String?
}

// Master-sourced from docs/roles.yaml's zones[].factions[]
// (db/lib/syncRoles.js#syncRolesFromYaml, npm run db:sync-roles). `slug` is
// the stable match key; `silo` is live game state and is only ever seeded on
// creation, never overwritten by a later sync.
model Faction {
  id   String  @id @default(cuid())
  slug String? @unique
  name String
  silo Int     @default(0)

  // The Zone this faction belongs to, from its nesting in roles.yaml. Used
  // to group the character-creation role picker (Zone -> Faction -> Role);
  // a faction's members are not confined to it.
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  // Authoring order within the zone, so the picker lists factions the way
  // roles.yaml does rather than alphabetically.
  sortOrder Int @default(0)

  roles Role[]

  // A parent faction's Leader/Treasurer can also manage a subject faction's
  // Silo (see db/lib/factionPermissions.js#getSiloAccess) — never the
  // reverse. Membership/leadership administration stays same-faction only.
  parentFactionId String?
  parentFaction   Faction?  @relation("FactionHierarchy", fields: [parentFactionId], references: [id])
  subjectFactions Faction[] @relation("FactionHierarchy")

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id                String   @id @default(cuid())
  name              String
  discordChannelIds String[]

  locations      Location[]
  factions       Faction[]
  characters     Character[]
  actions        Action[]
  defaultEfforts DefaultEffort[]
  notes          Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A place within a Zone (e.g. "church" within the "Town" zone), backed by a
// standard 1-category/3-channel Discord layout: a plain channel (the
// location itself, tupper+summary), a "-public" forum (tupper), and a
// "-private" text channel (tupper within its private threads only — see
// bot/src/lib/channels.js / web/lib/discordGuild.js isTupperChannel). The
// Access is a ViewChannel permission overwrite per resident, keyed on
// Character.discordUserId (type 1, a member overwrite), written to the
// category AND all three channels — a channel does not reliably inherit its
// category. See db/lib/locationAccess.js and bot/src/lib/location.js.
// discordCategoryId/discordChannelId/discordPublicChannelId/
// discordPrivateChannelId are null until the channels are provisioned by
// db/lib/syncLocations.js#provisionLocationChannels (npm run db:sync-locations).
// Provisioning is one-time — keyed on discordCategoryId being null — so a
// re-sync never re-applies permissions; npm run db:reprovision-locations
// verifies them, and rebuilds a named Location's channels with --apply.
//
// slug is the stable human-authored key used by docs/locations.yaml + the
// db:sync-locations script (db/prisma/sync-locations.js) to match rows
// across syncs — separate from `id` so the YAML doesn't need to know
// Prisma's generated cuids. tags are free-text flavor/categorization labels
// authored in the YAML, unrelated to the player-facing Tag/CharacterTag
// system.
//
// connectsTo/connectedFrom back a single undirected adjacency graph (not a
// directed "A can reach B but not vice versa" one), mastered by
// docs/locations.yaml's locationConnections list and applied by
// syncLocationsFromYaml, which always writes each Location's own
// `connectsTo` to its full neighbor set (both directions explicitly, never
// relying on Prisma's relation to mirror it) — so only `connectsTo` is ever
// read; `connectedFrom` exists solely because Prisma requires a named field
// on both sides of a self-relation and is otherwise unused. A Location pair
// not listed in the YAML is NOT connected — there is no "fully connected by
// default" fallback — which is what performMove (bot/src/lib/location.js)
// checks before allowing any Move (whether free or turn-spending).
model Location {
  id                  String   @id @default(cuid())
  slug                String?  @unique
  name                String
  description         String   @default("")
  publicSubLocations  String[] @default([])
  privateSubLocations String[] @default([])
  tags                String[] @default([])
  zoneId              String
  zone                Zone     @relation(fields: [zoneId], references: [id])

  // Where this location's node sits on the web app's Map panel, as
  // percentages of the plate (0-100, origin top-left). Mastered by `map:` in
  // docs/locations.yaml and rewritten on every sync, same as description /
  // publicSubLocations. Null means the location simply isn't drawn on the
  // plate — it's still reachable from the destination list beside it.
  mapX Float?
  mapY Float?

  discordCategoryId       String?
  discordChannelId        String?
  discordPublicChannelId  String?
  discordPrivateChannelId String?

  characters       Character[]
  startingForRoles Role[]      @relation("RoleStartingLocation")

  connectsTo    Location[] @relation("LocationConnections")
  connectedFrom Location[] @relation("LocationConnections")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id            String @id @default(cuid())
  discordUserId String

  // A displayed name is four parts, joined by
  // db/lib/characterName.js#formatCharacterName as
  // `Sir Jorren "the Blind" Vask`. `honorific` is picked freely by the player
  // from a fixed dropdown; `title` is GM-only and renders in quotes — no
  // player-facing form ever reads it, which is the whole lock.
  honorific String?
  firstName String
  title     String?
  lastName  String?

  // Denormalized mirror of formatCharacterName(...) above, same posture as
  // zoneId below. It exists because ~60 readers want a single string —
  // orderBy, `select: { name: true }`, the /gm/audit `contains` search, the
  // proxy webhook username and the dawnWipe map key — and Prisma cannot
  // concatenate columns in orderBy or contains, so dropping it would force
  // search and sort into OR-over-three-columns for correctness nobody sees.
  //
  // Exactly four writers keep it in sync, and every one of them goes
  // through formatCharacterName:
  //   web/app/(app)/character/createActions.js      (creation)
  //   web/app/(app)/character/actions.js            (player edit)
  //   web/app/(app)/gm/dev/actions.js               (GM raw edit)
  //   web/lib/dynasty.js                            (the Baron renames his house)
  // A fifth writer must do the same; `npm run db:backfill-name-parts` is the
  // drift check that catches one that doesn't.
  name String

  // Display-only snapshot of the role's name at creation. `roleId` is the
  // authoritative link; roleTitle survives so a GM can hand-write something
  // off-catalog and so history reads correctly if a Role row is later pruned.
  roleTitle String?
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id])

  factionId String?
  faction   Faction? @relation(fields: [factionId], references: [id])

  // zoneId is a denormalized mirror of location.zoneId, kept in sync
  // whenever locationId changes (see bot/src/lib/location.js) so the
  // existing zone-filter UI (players/turns tables, notes) and the zoneId
  // stamped onto Action/DefaultEffort/Note keep working unchanged.
  // locationId is the authoritative "where is this character" field and
  // the source of their category-level channel access.
  zoneId     String?
  zone       Zone?     @relation(fields: [zoneId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Personal Discord role titled after this character's BARE name (first +
  // last, via formatBareName) and seeded to a muted color by
  // db/lib/roleColor.js#hashNameToColor from that same bare string, re-synced
  // whenever it changes (web/lib/discordGuild.js#ensureCharacterRole). Bare,
  // not the displayed name: the role is an @-mentionable name token rather
  // than an RP surface, and seeding off the bare name means granting or
  // changing a title never renames or recolours anyone.
  // It is assigned to NOBODY and grants nothing — holding it would list the
  // player's account under the character's name. Channel access is a
  // per-member overwrite instead (db/lib/locationAccess.js).
  discordRoleId String? @unique

  isLeader    Boolean         @default(false)
  isTreasurer Boolean         @default(false)
  status      CharacterStatus @default(ALIVE)
  resources   Int             @default(0)

  // Unspent point-buy points. Seeded at creation with whatever the player
  // didn't spend in the wizard (budget minus purchases) and drawn down by
  // the mid-game store.
  tagPoints      Int     @default(0)
  avatarData     Bytes?
  avatarMimeType String?

  // The portrait maker's selection as JSON — part indices and palette indices,
  // never pixels. avatarData holds the render; this holds what it was built
  // from, so reopening the modal resumes where the player left off instead of
  // starting from the default face. Null for an uploaded picture or a letter
  // plaque. Validated on every read by
  // web/lib/portrait/catalog.js#parseSelection, so a stale index left behind
  // by a catalog change degrades to the default part rather than throwing.
  portrait          String?
  appearance        String?
  preferredNickname String?
  turnPingOptIn     Boolean @default(true)
  romanceOptOut     Boolean @default(false)

  // 18-90, or null until the player first sets one. Free to edit while null;
  // the moment a number lands it is fixed — the /character input renders
  // disabled and updateCharacterProfile refuses to overwrite a non-null age,
  // the same shape as the GM-granted `title` above. A GM can still change it
  // from /gm/dev/characters/[characterId]. Read by
  // db/lib/concealedIdentity.js for the Young/Old half of a concealed alias.
  age Int?

  // A single, persistent, self-set dread — see docs/systemdocs/REQUESTS.md
  // §5b. Deliberately three columns rather than a model: there is exactly one
  // per character, it has no ACTIVE/ENDED lifecycle (fulfilling it does NOT
  // consume it), and Undo restores the previous text from Request.effect, so
  // there is no history for a table to hold. Fulfilment history lives in the
  // Request/AuditLog rows.
  //
  // Named (optionally) as the last step of character creation and then locked
  // in: the first set is free, but changing it afterwards is a
  // CHANGE_WORST_FEAR request. Fulfilling it is a FULFILL_WORST_FEAR request
  // worth a flat -3 Tag Points, never a ladder.
  worstFear String?

  // Turn the current text was set on — display only.
  worstFearSetTurnNumber Int?

  // Turn it was last fulfilled on, driving the one-turn cooldown (blocked
  // while openTurn.number <= this). Null means never. The fear itself
  // PERSISTS through a fulfilment — same fear, again next turn — which is
  // why this is a turn stamp and not a status.
  worstFearLastFulfilledTurn Int?

  // Which secretly GM-assigned antagonist seats this player is open to being
  // handed (Succubus, Cultist, the Judge...). Consent data only: nothing in
  // the game reads it, grants from it, or gates on it — it exists so a GM
  // picking who receives one can tell who is willing.
  //
  // Set once, on the Antagonists step of the creation wizard, and never
  // player-editable afterwards; updateCharacterProfile not reading the key is
  // the lock, same posture as the GM-granted `title` above.
  //
  // A String[] of slugs validated against db/lib/antagonists.js rather than a
  // relation: eleven fixed values that can never differ per environment, so a
  // table would only add a join and a way to drift.
  antagonistOptIns String[] @default([])

  tags            CharacterTag[]
  actions         Action[]
  defaultEffort   DefaultEffort?
  setDefaultsFor  DefaultEffort[] @relation("DefaultEffortSetBy")
  auditLogTargets AuditLog[]
  notes           Note[]
  requests        Request[]
  desires         Desire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discordUserId])
  @@index([status])
}

// Master-sourced from docs/tags.yaml (db/lib/syncTags.js#syncTagsFromYaml,
// npm run db:sync-tags) — same non-destructive upsert-by-slug contract as
// Location/docs/locations.yaml: removing a tag from the YAML never deletes
// its row here.
model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  category    String
  pointCost   Int     @default(0)

  // Shown to other players who 🔍-react to this character's proxied
  // messages (see bot/src/events/messageReactionAdd.js), alongside
  // Character.appearance. Defaults closed so identity/status tags (Mortus,
  // Drained, ...) stay hidden unless explicitly opened up.
  visibleOnInspect Boolean @default(false)

  // Optional grouping within a category (e.g. Status -> Health/Food/Buffs/
  // Debuffs), purely for display coloring (see TagGroup.color / TagChip.js)
  // — groupless tags render with no color accent.
  groupId String?
  group   TagGroup? @relation(fields: [groupId], references: [id])

  // For sequential/tiered skill tags (Cooking (Basic) -> Cooking (Skilled)):
  // the tier this one upgrades from. Buying/granting a tag with a parent
  // replaces the parent on the character rather than stacking with it.
  parentTagId String?
  parentTag   Tag?    @relation("TagUpgrade", fields: [parentTagId], references: [id])
  upgrades    Tag[]   @relation("TagUpgrade")

  // Non-replacing prerequisite, distinct from the parentTag chain above: a
  // character must already hold requiredTag before this one is meant to be
  // obtainable, but acquiring this one does NOT remove/replace requiredTag
  // (e.g. Fighting (Archer) requires Fighting (Basic) but coexists with
  // Fighting (Skilled)). Also the mechanism behind whole-group gating — see
  // TagGroup.requiredTag — for hiding an entire group behind a membership
  // tag. Both are enforced by requirementSatisfied()
  // (web/lib/characterCreation.js): the point-buy menu, the Add Tag picker,
  // and the createCharacter/addTagRequest server actions that re-check them.
  // A GM grant still ignores both, deliberately.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagPrerequisite", fields: [requiredTagId], references: [id])
  unlocks       Tag[]   @relation("TagPrerequisite")

  // Items-category flag for a future trade flow — no transfer logic exists
  // yet, this just marks which tags are candidates for it.
  tradeable Boolean @default(false)

  // Whether this tag is a thing a character can wear or carry readied, and so
  // occupies one of their GameConfig.equipSlots. Equipped state lives on
  // CharacterTag.equipped; equipping is instant and writes no Request.
  equippable Boolean @default(false)

  // Marks gear that hides who the wearer is — a mask, hood or closed helm.
  // Currently INERT: /conceal is open to every character with nothing
  // equipped, and nothing reads this field. Kept so the gate can be restored
  // without a migration. Only meaningful together with equippable, and
  // db/lib/syncTags.js throws if it is set without it, since a mask nobody can
  // equip could never conceal anything. See docs/systemdocs/TAGS.md.
  concealsIdentity Boolean @default(false)

  // Whether a character can hold more than one of this tag at a time —
  // meals, ammunition, anything a crafting Move produces in a batch. A
  // stack is ONE CharacterTag row carrying a count (CharacterTag.quantity),
  // never N rows: @@unique([characterId, tagId]) stays, so every presence
  // check in the codebase (narrowcastAccess, gambitModifier, mood, labor)
  // keeps reading "holds it or doesn't" unchanged. Safe to combine with
  // defaultDurationTurns: the expiry sweep sheds one unit per expiry and
  // rerolls the remaining stack's timer, rather than deleting the row.
  stackable Boolean @default(false)

  // Whether a player could ever buy this via point-buy, and (only meaningful
  // when true) whether it stays buyable once the game is underway vs. being
  // a starting-package-only pick. No purchase flow exists yet — catalog data
  // only, for a future store to read.
  purchasable           Boolean @default(false)
  purchasableAfterStart Boolean @default(true)

  // Catalog-level default duration in turns, for tags that auto-expire once
  // granted (mirrors CharacterTag.expiresTurn's "absolute turn number, swept
  // by resolveNeeds()" convention). E.g. Drained sets this to 3, so donating
  // blood expires 3 turns after it's granted.
  defaultDurationTurns Int?

  // Whether a player can use this tag up — eat the meal, unpack the crate.
  // Live, like removable/craftable above: it drives the Consume menu on
  // /character (web/lib/tagRequests.js) and is re-checked server-side by
  // consumeTagRequest, since the client's filtered menu is only advisory.
  // See docs/systemdocs/REQUESTS.md. Consuming always takes exactly ONE
  // unit, so a stack of meals feeds the character several times.
  consumable Boolean @default(false)

  // Tag slugs this tag turns INTO when it is consumed: a meal becoming Ate
  // Meal, Starting Wares unpacking into a revolver and jewelry. Slugs rather
  // than a relation specifically so a slug may REPEAT — listing one twice
  // grants two of it (for a stackable tag; a non-stackable repeat collapses
  // to one). A granted tag with its own defaultDurationTurns starts that
  // clock at the moment it's granted, so chains work (meal -> Ate Meal that
  // the sweep then clears). Empty means consuming just uses the tag up.
  consumesInto String[]

  // Per-target conditions on the list above, as { "<target slug>": ["<blocking
  // slug>", ...] } — the target is granted only if the character holds NONE of
  // its blocking tags. Null when a tag's grants are all unconditional, which is
  // almost all of them. consumesInto still carries every target slug in order,
  // so validation and the "Becomes:" previews keep reading one field.
  //
  // Fine Meal is the case this exists for: { "happy": ["nobility"] } — an
  // ordinary person is cheered by a good meal, a noble expects one as a matter
  // of course. Resolved by web/lib/consumeGrants.js, which both the server
  // action and the client previews call so a preview can't promise a mood
  // lift the grant won't deliver.
  consumesIntoUnless Json?

  // Whether a player can remove this tag from themselves mid-game without a
  // GM. Catalog data only — no self-removal flow reads this yet (the
  // mid-game tag store isn't routed), same posture as tradeable above.
  removable Boolean @default(false)

  // Whether this tag represents something a player can craft/make, as
  // opposed to a tag that only ever arrives via role, GM grant, or
  // automatic game logic. Catalog data only — no crafting flow reads this
  // yet, same posture as removable/tradeable.
  craftable Boolean @default(false)

  // --- Requirement to add or remove this tag in play -------------------
  // What it costs a character to gain or shed this tag through play (e.g.
  // curing Arthritis needs Medical (Skilled), some turns, and resources;
  // forging a sword tag costs turns, resources, Smithing, no Gambit). One
  // shared set of fields covers whichever direction is narratively relevant
  // for a given tag (crafting only cares about adding it; healing only cares
  // about removing it) rather than separate add/remove blocks.
  //
  // Mostly a GM adjudication reference, shown to players, with ONE exception:
  // the Heal request (RequestType.HEAL_CHARACTER) enforces the removal
  // direction on Status tags — requirementResources is the ⬢ it charges and
  // requirementSkills is what the medic must hold. Turns and Gambit stay
  // reference-only everywhere, as do all four when adding a tag.
  requirementTurns     Int?
  requirementResources Int?
  requirementGambit    Boolean @default(false)
  requirementSkills    Tag[]   @relation("TagRequirementSkill")
  requiredForSkillOf   Tag[]   @relation("TagRequirementSkill")

  characters  CharacterTag[]
  gatedGroups TagGroup[]     @relation("TagGroupGate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Optional grouping of tags within a single category, purely for display
// coloring (see TagChip.js) — e.g. the Status category's Health/Food/Buffs/
// Debuffs groups. Also master-sourced from docs/tags.yaml, same
// non-destructive upsert-by-slug contract as Tag.
model TagGroup {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Must match one of the categories declared at the top of docs/tags.yaml —
  // a plain string, not a DB-enforced FK, same as Tag.category.
  category String

  // Freeform hex color (e.g. "#6fa8ab"), rendered directly by TagChip.js —
  // null means uncolored. Not theme-aware; docs/taggroups.yaml is the
  // source of truth for values in use.
  color String?

  // Whole-group gate: every tag in this group stays hidden until the
  // character holds requiredTag. This is the hidden-category mechanism —
  // the Demoness and Bacchus categories each hold exactly one gated group,
  // so until you hold the unlocking tag the category has no tab in any
  // picker and its tags are withheld from /api/tags outright. Live:
  // requirementSatisfied() in web/lib/characterCreation.js is the single
  // reader, called by PointBuy, the Add Tag picker, createCharacter and
  // addTagRequest; the API route filters on it directly.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagGroupGate", fields: [requiredTagId], references: [id])

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTag {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  source      TagSource
  acquiredAt  DateTime  @default(now())

  // Turn number this tag expires at, swept by resolveNeeds() in db/index.js
  // once the closing turn's number reaches it. Null means it never
  // auto-expires. An ordinary tag's row is deleted; a Tag.stackable one
  // instead loses a single unit and has this field pushed forward by the
  // tag's defaultDurationTurns, until the last unit takes the row with it.
  // Used for system-granted temporary status tags (Ate Meal, Tipsy) — see
  // EVENT below.
  expiresTurn Int?

  // Whether this held tag is currently equipped, capped across a character by
  // GameConfig.equipSlots and only ever true for a Tag.equippable one. A
  // stackable tag takes ONE slot however many units are held — the flag is a
  // property of holding the tag, not of each unit, which is also why this is
  // a column here rather than a separate join table.
  equipped Boolean @default(false)

  // How many of this tag the character holds. Always 1 for an ordinary tag;
  // only Tag.stackable ones ever go above it, and nothing may drive it
  // below 1 — the row is deleted instead. Point-buy never sets this: the
  // wizard is a toggle-set, so a bought tag lands on the default.
  quantity Int @default(1)

  @@unique([characterId, tagId])
}

// A playable seat, master-sourced from docs/roles.yaml's
// zones[].factions[].roles[] (db/lib/syncRoles.js, npm run db:sync-roles).
// Threats are deliberately not in that YAML at all — they live in
// docs/threats.md as prose, hand-assigned by a GM, and never appear in the
// player-facing picker.
model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  intro       String   @default("")
  description String[] @default([])
  difficulty  String?

  // Authoring order within the faction, so the picker matches roles.yaml.
  sortOrder Int @default(0)

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id])

  // Seat math, from the YAML's `multiple`/`weight` pair. Exactly one of
  // these three shapes applies, resolved by roleCapacity() in
  // db/lib/roleCapacity.js:
  //   isUnique  -> exactly 1 seat, forever (`multiple: false`)
  //   unlimited -> no cap at any scale (`weight: unlimited`)
  //   weight    -> round(weight * GameConfig.playerCount / 100)
  isUnique  Boolean @default(false)
  unlimited Boolean @default(false)
  weight    Int?

  // The starting package handed to a character who picks this role.
  startingResources   Int      @default(0)
  extraStartingPoints Int      @default(0)
  startingTagSlugs    String[] @default([])
  grantsLeader        Boolean  @default(false)
  grantsTreasurer     Boolean  @default(false)
  docElements         String[] @default([])

  // Where characters with this role begin — and therefore the one Location
  // category their personal Discord role gets ViewChannel on at creation.
  startingLocationId String?
  startingLocation   Location? @relation("RoleStartingLocation", fields: [startingLocationId], references: [id])

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId])
}

// Master-sourced from docs/documents.yaml
// (db/lib/syncDocuments.js#syncDocumentsFromYaml, npm run db:sync-documents).
// `key` is the stable match key, and is what docs/roles.yaml's
// `doc_elements` lists point at. The sync is destructive: an entry no longer
// in the YAML has its row removed, same posture as syncLocations.
//
// Assignment is denormalized into string arrays rather than join tables. The
// catalog is ~30 rows, fully rebuilt from YAML on every sync, and read in one
// query per page view, so four relations would buy nothing. A document is
// ASSIGNED to a character if ANY of these matches: their role's docElements
// lists this key, they hold one of tagSlugs, their role is in roleSlugs,
// their faction is in factionSlugs, or flags names a Character boolean they
// have set.
model Document {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String @default("")

  // Everyone sees it, character or not — this is what the PUBLIC tab of
  // /documents renders, and the reason that page is readable before the
  // game opens.
  isPublic Boolean @default(false)

  tagSlugs     String[] @default([])
  roleSlugs    String[] @default([])
  factionSlugs String[] @default([])
  // "leader" / "treasurer", read against Character.isLeader/isTreasurer,
  // which are booleans rather than tags (see docs/systemdocs/TAGS.md §6).
  flags        String[] @default([])

  // Authoring order from the YAML, so the gallery matches the file.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turn {
  id         String     @id @default(cuid())
  number     Int        @unique
  phase      TurnPhase
  weather    Weather    @default(CLEAR)
  gameDate   DateTime
  status     TurnStatus @default(OPEN)
  startedAt  DateTime   @default(now())
  resolvedAt DateTime?

  actions  Action[]
  requests Request[]
}

model Action {
  id                     String      @id @default(cuid())
  characterId            String
  character              Character   @relation(fields: [characterId], references: [id])
  turnId                 String
  turn                   Turn        @relation(fields: [turnId], references: [id])
  type                   ActionType?
  description            String
  zoneId                 String?
  zone                   Zone?       @relation(fields: [zoneId], references: [id])
  resourceDelta          Int?
  // A range like "5-12", rolled at ⚜ confirm. @map keeps the original column
  // names: this used to hold dice notation ("1d6*2"), which the labor
  // shorthands and ranges replaced, so the field renamed but the SQL didn't.
  resourceRollExpression String?     @map("resourceDiceExpression")
  resourceRollValue      Int?        @map("resourceDiceRoll")
  diceRoll               Int?

  // The mood adjustment applied to a Gambit's d6 (+1 Happy / -1 Unhappy, see
  // db/lib/mood.js). Kept SEPARATE from diceRoll, which always stores the raw
  // roll — otherwise a GM can't tell a modified 5 from a natural 5, and a
  // re-roll during adjudication would compound the modifier.
  diceModifier Int?
  status       ActionStatus @default(PENDING)

  // Routine vs Gambit (see MoveKind above), whether the player and/or GM has
  // flagged it Opposed, and the GM's spreadsheet-workflow status — all set
  // during the DM submission flow (moveKind/opposed) and/or later edited by
  // a GM from the Moves adjudication popup (all three, plus moveReviewStatus
  // itself).
  moveKind         MoveKind?
  opposed          Boolean          @default(false)
  moveReviewStatus MoveReviewStatus @default(OPEN)

  // GM-facing only, never auto-sent to players — labeled "Outcome" and
  // "Other Notes" in the GM UI. GMs message players manually (see
  // sendPartyMessages/sendGmMessage in web/app/(app)/gm/actions.js) once
  // they've written these up.
  // Who resolved this Move and when. Request has carried these since the
  // rework; Moves need them too now that several GMs share the queue behind a
  // lock. The ID is stored, the Discord username is rendered.
  reviewedAt              DateTime?
  reviewedByDiscordUserId String?

  // Cooperative lock so two GMs don't adjudicate the same Move. Deliberately
  // NOT moveReviewStatus: a crashed browser lets lockExpiresAt lapse, where a
  // status write would strand the row "In Progress" forever. The Moves table
  // derives "In Progress" from a live lock.
  lockedByDiscordUserId String?
  lockExpiresAt         DateTime?

  // Snapshot of what a Solve actually pushed onto the sheet — `{"resources":5}`
  // today. Revert-on-unsolve reads ONLY this and never re-derives from live
  // state, the same payload-vs-effect rule Request.effect follows (see
  // REQUESTS.md §2). JSON rather than an Int so the push can grow past
  // resources without a migration. Null means nothing has been pushed yet.
  appliedEffects Json?

  resultMessage      String?
  gmNotes            String?
  forumThreadId      String?
  confirmDmMessageId String?   @unique
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([status, createdAt])
  @@index([characterId])
  @@index([turnId])
}

model DefaultEffort {
  id               String     @id @default(cuid())
  characterId      String     @unique
  character        Character  @relation(fields: [characterId], references: [id])
  description      String
  zoneId           String?
  zone             Zone?      @relation(fields: [zoneId], references: [id])
  resourceDelta    Int?
  shareInSummary   Boolean    @default(false)
  summaryChannelId String?
  summaryMessage   String?
  setByCharacterId String?
  setByCharacter   Character? @relation("DefaultEffortSetBy", fields: [setByCharacterId], references: [id])
  updatedAt        DateTime   @updatedAt
}

enum DmDirection {
  INBOUND
  OUTBOUND
}

model DirectMessage {
  id            String      @id @default(cuid())
  discordUserId String
  direction     DmDirection
  content       String
  createdAt     DateTime    @default(now())

  @@index([discordUserId, createdAt])
  @@index([createdAt])
}

// A player's personal note on a message in a Location channel — created by
// reacting ⭐ to any proxied message (bot/src/events/messageReactionAdd.js);
// the bot strips the reaction back off immediately, so the note's presence
// on /notes is the only lasting trace, not the Discord reaction itself. Each
// (message, starrer) pair gets its own row, since a note is personal to
// whoever starred it — not a shared/aggregate count.
model Note {
  id               String     @id @default(cuid())
  discordMessageId String
  discordChannelId String
  characterId      String?
  character        Character? @relation(fields: [characterId], references: [id])
  characterName    String
  zoneId           String?
  zone             Zone?      @relation(fields: [zoneId], references: [id])
  content          String
  sentAt           DateTime
  discordUserId    String
  createdAt        DateTime   @default(now())

  @@unique([discordMessageId, discordUserId])
  @@index([discordUserId])
  @@index([zoneId])
}

// One row per change to a Faction's Silo — deposits, manual Dev Panel
// corrections, and Leader/Treasurer transfers to a member — so the faction
// panel can show a plain-language "who took what, when, how much, to whom"
// history instead of just the current total. `amount` is signed: positive
// grows the silo, negative shrinks it. No FK relations (log rows should
// survive/ignore character or faction deletion) — snapshot names instead,
// same reasoning as AuditLog.
model SiloTransaction {
  id                 String     @id @default(cuid())
  factionId          String
  amount             Int
  actorDiscordUserId String
  actorCharacterId   String?
  actorName          String
  toCharacterId      String?
  toName             String?
  turnNumber         Int?
  turnPhase          TurnPhase?
  note               String?
  createdAt          DateTime   @default(now())

  @@index([factionId])
}

model AuditLog {
  id                 String     @id @default(cuid())
  actorDiscordUserId String
  actionType         String
  targetCharacterId  String?
  targetCharacter    Character? @relation(fields: [targetCharacterId], references: [id])
  details            Json?

  // Only populated by Request-backed entries (see RequestType) — the
  // player's own words, surfaced as a column on /gm/audit.
  reason    String?
  createdAt DateTime @default(now())

  @@index([actionType])
  @@index([actorDiscordUserId])
}

// One row per player action that took effect without GM approval. `payload`
// is what the player asked for; `effect` is what was actually applied, and is
// the ONLY thing Undo reads. That split is load-bearing: reversing a request
// by re-deriving it from current state would corrupt as soon as a GM edits an
// amount or the character transacts again in the meantime.
model Request {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id])
  turnId      String?
  turn        Turn?         @relation(fields: [turnId], references: [id])
  type        RequestType
  status      RequestStatus @default(PASSED)
  reason      String
  payload     Json
  effect      Json
  gmNotes     String?

  reviewedAt              DateTime?
  reviewedByDiscordUserId String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([characterId])
}

// A character's self-set goal, worth 1-5 Tag Points on fulfillment. At most
// one ACTIVE row per character (enforced in the server action, not the
// schema, since the constraint is "one ACTIVE" rather than "one row").
// endedTurnNumber drives the one-turn cooldown after a cancel or a fulfill.
model Desire {
  id              String       @id @default(cuid())
  characterId     String
  character       Character    @relation(fields: [characterId], references: [id])
  text            String
  points          Int
  status          DesireStatus @default(ACTIVE)
  setTurnNumber   Int?
  endedTurnNumber Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
}

// The game's transcript, and the backing store for /archive.
//
// Written at SEND time (db/lib/archive.js, called from the two proxy paths),
// not reconstructed at Dawn. The old dawnWipe.js archived by reading messages
// back out of Discord and re-posting them into one #archive channel — ~850
// sequential posts down a single ~1 msg/sec lane on a busy turn, which was the
// most expensive thing the bot did and grew with player count. It also had to
// guess: the character was matched by *current* name (so a rename
// mis-attributed everything they'd ever said) and the turn was inferred by
// comparing timestamps against Turn.gameDate. Recording at write time makes
// both exact and reduces the wipe to deletes.
//
// The id columns are deliberately NOT foreign keys, same posture as
// SiloTransaction and AuditLog's snapshot fields. Two things in this codebase
// destructively delete the rows they'd point at: syncLocationsFromYaml removes
// any Location dropped from the YAML, and wipeGameData clears Characters. A
// real relation would either take the transcript with it or fail on FK
// ordering (which Restart Game has already been bitten by once). Plain indexed
// ids plus name snapshots survive both, and the snapshot is the more correct
// record anyway — who someone was known as *then*.
model ArchiveEntry {
  id   String      @id @default(cuid())
  kind ArchiveKind @default(MESSAGE)

  // Stamped from the open turn as the row is written.
  turnNumber Int?
  turnPhase  TurnPhase?
  sentAt     DateTime   @default(now())

  locationId    String?
  locationName  String?
  characterId   String?
  characterName String?

  // Non-null only for a message sent through /conceal. Both halves are kept:
  // the panel renders "Young Man (Sir Alder)", so the alias is what was seen
  // and characterName is who it actually was.
  concealedAlias String?

  content String

  // How ✏️ and ❌ find this row again to update or remove it. Null for system
  // events, which have no Discord message behind them.
  discordMessageId String? @unique

  // plain | public | private | radio | intercom — lets the panel keep a
  // location's summary channel apart from its forum scenes.
  channelKind String?

  // Forum post / thread title, so a scene reads as one unit rather than
  // scattered lines under its location.
  threadName String?

  createdAt DateTime @default(now())

  @@index([sentAt])
  @@index([turnNumber])
  @@index([kind])
  @@index([locationId, sentAt])
  @@index([characterId, sentAt])
}
