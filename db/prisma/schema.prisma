generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharacterStatus {
  ALIVE
  DEAD
  CURSED
}

enum MoodState {
  NEUTRAL
  HAPPY
  UNHAPPY
}

enum ActionType {
  EFFORT
  MOVE
}

enum ActionStatus {
  PENDING_TYPE
  PENDING
  CONFIRMED
  ADJUDICATED
}

enum DesireStatus {
  ACTIVE
  PENDING
  COMPLETED
  ABANDONED
}

enum TurnPhase {
  DAWN
  DUSK
}

enum TurnStatus {
  OPEN
  RESOLVED
}

enum Weather {
  CLEAR
  FOG
  RAIN
  STORM
  MIGRATION
}

enum TagSource {
  POINT_BUY
  DESIRE_REWARD
  GM_GRANT
  LEADER_GRANT
  EVENT
}

enum TagChangeRequestStatus {
  PENDING
  RESOLVED
}

model GameConfig {
  id                        Int @id @default(1)
  startingTagPoints         Int @default(0)
  resourceConsumptionPerTurn Int @default(1)
  moodDurationTurns         Int @default(2)
  hungerMovePenalty         Int @default(-1)
  moodMovePenalty           Int @default(-1)
  moodMoveBonus             Int @default(1)
  alcoholCost               Int @default(3)
  alcoholShieldDurationTurns Int @default(4)
  lifewebBlood              Int @default(100)
  lifewebDecayPerTurn       Int @default(10)
  lifewebDrainedDurationTurns Int @default(4)
  nextWeather               Weather?
  nextTurnNote              String?
  turnsAnnouncementChannelId String?
  turnsAnnouncementMessageId String?

  // The single, always-present "location" channel used for the zone/location
  // travel picker (see bot/src/lib/location.js) — same tracked-message
  // pattern as turnsAnnouncement* above.
  locationPromptChannelId String?
  locationPromptMessageId String?
}

model Faction {
  id            String  @id @default(cuid())
  name          String
  discordRoleId String  @unique
  silo          Int     @default(0)

  // A parent faction's Leader/Treasurer can also manage a subject faction's
  // Silo (see web/lib/factionPermissions.js#getSiloAccess) — never the
  // reverse. Membership/leadership administration stays same-faction only.
  parentFactionId String?
  parentFaction   Faction?  @relation("FactionHierarchy", fields: [parentFactionId], references: [id])
  subjectFactions Faction[] @relation("FactionHierarchy")

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Zone {
  id                String   @id @default(cuid())
  name              String
  discordChannelIds String[]

  locations      Location[]
  characters     Character[]
  actions        Action[]
  defaultEfforts DefaultEffort[]
  archivedMessages ArchivedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A place within a Zone (e.g. "church" within the "Town" zone), backed by a
// standard 1-category/3-channel Discord layout: a plain channel (the
// location itself, tupper+summary), a "-public" forum (tupper), and a
// "-private" text channel (tupper within its private threads only — see
// bot/src/lib/channels.js / web/lib/discordGuild.js isTupperChannel). The
// category's permission overwrites (one per resident Character.discordRoleId)
// are the actual access-control mechanism — see bot/src/lib/location.js.
// discordCategoryId/discordChannelId/discordPublicChannelId/
// discordPrivateChannelId are null until a GM provisions the channels from
// /gm/dev/zones (web/app/(app)/gm/dev/actions.js#provisionLocationChannels).
model Location {
  id                      String  @id @default(cuid())
  name                    String
  zoneId                  String
  zone                    Zone    @relation(fields: [zoneId], references: [id])

  discordCategoryId       String?
  discordChannelId        String?
  discordPublicChannelId  String?
  discordPrivateChannelId String?

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id             String          @id @default(cuid())
  discordUserId  String
  name           String
  roleTitle      String?
  factionId      String?
  faction        Faction?        @relation(fields: [factionId], references: [id])

  // zoneId is a denormalized mirror of location.zoneId, kept in sync
  // whenever locationId changes (see bot/src/lib/location.js) so the
  // existing zone-filter UI (players/turns tables, archive) and the zoneId
  // stamped onto Action/DefaultEffort/ArchivedMessage keep working
  // unchanged. locationId is the authoritative "where is this character"
  // field and the source of their category-level channel access.
  zoneId         String?
  zone           Zone?           @relation(fields: [zoneId], references: [id])
  locationId     String?
  location       Location?       @relation(fields: [locationId], references: [id])

  // Personal Discord role titled after this character's name, seeded to a
  // muted color by db/lib/roleColor.js#hashNameToColor and re-synced
  // whenever name changes (web/lib/discordGuild.js#ensureCharacterRole).
  // Doubles as the access-control primitive for Location categories.
  discordRoleId  String?         @unique

  isLeader       Boolean         @default(false)
  status         CharacterStatus @default(ALIVE)
  resources      Int             @default(0)
  tagPoints      Int             @default(0)
  moodState      MoodState       @default(NEUTRAL)
  moodExpiresTurn Int?
  moodNote       String?
  isHungry       Boolean         @default(false)
  skipNextMealConsumption Boolean @default(false)
  lastFineMealTurn Int?
  avatarData     Bytes?
  avatarMimeType String?
  appearance     String?
  preferredNickname String?
  turnPingOptIn  Boolean         @default(true)

  tags           CharacterTag[]
  desires        Desire[]
  tagChangeRequests TagChangeRequest[]
  actions        Action[]
  defaultEffort  DefaultEffort?
  setDefaultsFor DefaultEffort[] @relation("DefaultEffortSetBy")
  auditLogTargets AuditLog[]
  archivedMessages ArchivedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discordUserId])
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String?  @unique
  description String?
  category    String?
  pointCost   Int      @default(0)

  // Shown to other players who 🔍-react to this character's proxied
  // messages (see bot/src/events/messageReactionAdd.js), alongside
  // Character.appearance. Defaults closed so identity/status tags (Mortus,
  // Leader, Drained, ...) stay hidden unless explicitly opened up.
  visibleOnInspect Boolean @default(false)

  // For sequential/tiered skill tags (Cooking (Basic) -> Cooking (Skilled)):
  // the tier this one upgrades from. Buying/granting a tag with a parent
  // replaces the parent on the character rather than stacking with it.
  parentTagId String?
  parentTag   Tag?     @relation("TagUpgrade", fields: [parentTagId], references: [id])
  upgrades    Tag[]    @relation("TagUpgrade")

  characters CharacterTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTag {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  source      TagSource
  acquiredAt  DateTime  @default(now())

  // Turn number this tag auto-expires at (deleted by resolveNeeds() in
  // db/index.js once the closing turn's number reaches it), same convention
  // as Character.moodExpiresTurn. Null means it never auto-expires. Used for
  // system-granted temporary status tags (Ate Meal, Tipsy) — see EVENT below.
  expiresTurn Int?

  @@unique([characterId, tagId])
}

model Desire {
  id            String       @id @default(cuid())
  characterId   String
  character     Character    @relation(fields: [characterId], references: [id])
  description   String
  status        DesireStatus @default(ACTIVE)
  turnNumber    Int?
  pointsAwarded Int?
  resultMessage String?
  gmNotes       String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
}

// A player-submitted note that their character's tags need GM attention
// (wrong, missing, outdated) — reviewed from the Tags tab of /gm/turns,
// same PENDING -> terminal shape as Desire but without a points award.
model TagChangeRequest {
  id                       String                  @id @default(cuid())
  characterId              String
  character                Character               @relation(fields: [characterId], references: [id])
  requestedByDiscordUserId String
  description              String
  status                   TagChangeRequestStatus  @default(PENDING)
  resultMessage            String?
  gmNotes                  String?
  createdAt                DateTime                @default(now())
  resolvedAt               DateTime?
}

model Turn {
  id          String     @id @default(cuid())
  number      Int        @unique
  phase       TurnPhase
  weather     Weather    @default(CLEAR)
  gameDate    DateTime
  status      TurnStatus @default(OPEN)
  startedAt   DateTime   @default(now())
  resolvedAt  DateTime?

  actions Action[]
}

model Action {
  id             String       @id @default(cuid())
  characterId    String
  character      Character    @relation(fields: [characterId], references: [id])
  turnId         String
  turn           Turn         @relation(fields: [turnId], references: [id])
  type           ActionType?
  description    String
  zoneId         String?
  zone           Zone?        @relation(fields: [zoneId], references: [id])
  resourceDelta  Int?
  resourceDiceExpression String?
  resourceDiceRoll Int?
  diceRoll       Int?
  isPublic       Boolean      @default(true)
  status         ActionStatus @default(PENDING)
  resultMessage  String?
  gmNotes        String?
  forumThreadId  String?
  confirmDmMessageId String? @unique
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model DefaultEffort {
  id               String    @id @default(cuid())
  characterId      String    @unique
  character        Character @relation(fields: [characterId], references: [id])
  description      String
  zoneId           String?
  zone             Zone?     @relation(fields: [zoneId], references: [id])
  resourceDelta    Int?
  shareInSummary   Boolean   @default(false)
  summaryChannelId String?
  summaryMessage   String?
  setByCharacterId String?
  setByCharacter   Character? @relation("DefaultEffortSetBy", fields: [setByCharacterId], references: [id])
  updatedAt        DateTime  @updatedAt
}

enum DmDirection {
  INBOUND
  OUTBOUND
}

model DirectMessage {
  id            String      @id @default(cuid())
  discordUserId String
  direction     DmDirection
  content       String
  createdAt     DateTime    @default(now())

  @@index([discordUserId])
  @@index([createdAt])
}

model ArchivedMessage {
  id               String    @id @default(cuid())
  discordMessageId String    @unique
  discordChannelId String
  characterId      String?
  character        Character? @relation(fields: [characterId], references: [id])
  characterName    String
  zoneId           String?
  zone             Zone?     @relation(fields: [zoneId], references: [id])
  content          String
  starCount        Int       @default(1)
  sentAt           DateTime
  archivedAt       DateTime  @default(now())

  stars MessageStar[]

  @@index([zoneId])
  @@index([starCount])
}

// One row per (message, starrer) — lets a player's archive view show only
// messages *they* starred, since matching a player's actual Discord read
// access (zones, private threads for secret conversations, etc.) isn't
// something the archive tracks.
model MessageStar {
  id                String          @id @default(cuid())
  archivedMessageId String
  archivedMessage   ArchivedMessage @relation(fields: [archivedMessageId], references: [id])
  discordUserId     String
  createdAt         DateTime        @default(now())

  @@unique([archivedMessageId, discordUserId])
  @@index([discordUserId])
}

// One row per change to a Faction's Silo — deposits, manual Dev Panel
// corrections, and Leader/Treasurer transfers to a member — so the faction
// panel can show a plain-language "who took what, when, how much, to whom"
// history instead of just the current total. `amount` is signed: positive
// grows the silo, negative shrinks it. No FK relations (log rows should
// survive/ignore character or faction deletion) — snapshot names instead,
// same reasoning as AuditLog.
model SiloTransaction {
  id                 String     @id @default(cuid())
  factionId          String
  amount             Int
  actorDiscordUserId String
  actorCharacterId   String?
  actorName          String
  toCharacterId      String?
  toName             String?
  turnNumber         Int?
  turnPhase          TurnPhase?
  note               String?
  createdAt          DateTime   @default(now())

  @@index([factionId])
}

model AuditLog {
  id                 String    @id @default(cuid())
  actorDiscordUserId String
  actionType         String
  targetCharacterId  String?
  targetCharacter    Character? @relation(fields: [targetCharacterId], references: [id])
  details            Json?
  createdAt          DateTime  @default(now())

  @@index([actionType])
  @@index([actorDiscordUserId])
}
