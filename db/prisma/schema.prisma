generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharacterStatus {
  ALIVE
  DEAD
  CURSED
}

// How a character presents. Chosen once at creation and never editable by the
// player afterwards (a GM can correct one from the dev panel).
//
// It does two jobs, and both used to be inferred from the honorific: it picks
// WHICH word of a gendered title a character wears — a Man holding Nobility is
// Lord, a Woman is Lady, Neutral is Noble (db/lib/titles.js) — and it is the
// Man/Woman/Person half of a concealed alias
// (db/lib/concealedIdentity.js). NEUTRAL is a real answer, not an absent one:
// every gendered title carries a neutral third, and a neutral character draws
// their rolled name from both pools.
enum Gender {
  MAN
  WOMAN
  NEUTRAL
}

enum ActionType {
  EFFORT
  MOVE
}

enum ActionStatus {
  PENDING_TYPE
  // Legacy: Opposed no longer exists as a submission-flow state. Nothing
  // writes this. Kept in the enum (rather than removed) for the same reason
  // as ADJUDICATED below — a Postgres enum-value removal is riskier than an
  // unused value.
  PENDING_OPPOSED
  PENDING
  CONFIRMED
  // Legacy terminal state from the pre-rework adjudication flow. No longer
  // written by new code — a CONFIRMED Move's GM-facing progress now lives on
  // moveReviewStatus instead. Kept in the enum (rather than removed) so old
  // rows don't need a risky Postgres enum-value migration.
  ADJUDICATED
}

// Routine/Gambit replaces the old Effort/Move split (ActionType, below) —
// Gambit is the only kind that rolls a d6. ActionType/Action.type stay in
// the schema for historical rows but are no longer meaningfully set beyond
// a constant "MOVE" going forward.
enum MoveKind {
  ROUTINE
  GAMBIT
  // Working the day. Files itself when a player submits nothing (the auto-labor
  // pass, db/lib/autoLaborPass.js) and can be picked by hand on the Move modal.
  // Never arbitrated and never rolls a die - it resolves entirely from the
  // character's Laboring tags and where they stand (db/lib/laborAccess.js).
  LABOR
}

// GM-facing spreadsheet status, tracked independently of ActionStatus (which
// only covers the player-side submission pipeline up through CONFIRMED).
enum MoveReviewStatus {
  OPEN
  // Legacy: nothing ever set this — a GM parked an Opposed Move by simply not
  // solving it yet, and Opposed itself has since been removed. Kept in the
  // enum rather than removed; see ActionStatus.PENDING_OPPOSED above.
  WAITING_FOR_OPPONENTS
  IN_PROGRESS
  SOLVED
  // Where every Routine lands the moment it's confirmed: its effects have
  // already been pushed, so it needs a GM only if one disagrees. Rendered as
  // plain body text, same as OPEN — neither is a state worth shouting about.
  PASSED
}

enum TurnPhase {
  DAWN
  DUSK
}

// What kind of place a Zone row is. SURFACE zones own the full category +
// #summary/#public/#private layout. The Caves are special: one CAVE_GROUP row
// owns the category and the GM seat but is not a place a character can stand,
// and each CAVE_LEVEL under it owns a single forum channel and IS a presence
// unit — you only see the level you're in. See docs/systemdocs/CHANNELS.md.
enum ZoneKind {
  SURFACE
  CAVE_GROUP
  CAVE_LEVEL
}

// A Room is a thread under its Location's channel. PUBLIC is a public thread
// anyone standing in the Location can read; PRIVATE is a private thread whose
// members are exactly the characters holding one of its accessTagSlugs,
// reconciled by db/lib/roomAccess.js.
enum RoomKind {
  PUBLIC
  PRIVATE
}

// Which operational pass a SystemReport row records the outcome of.
enum SystemReportKind {
  WIPE
  DOCTOR
  DAWN_WIPE
  BULK_MOVE
}

enum TurnStatus {
  OPEN
  RESOLVED
}

enum Weather {
  CLEAR
  FOG
  RAIN
  STORM
}

// How much of a tag a 🔍 inspect shows to somebody else. HIDDEN is the
// default and the common case; ALWAYS is worn-or-not; WORN is the concealable
// middle — a dagger in a pocket, a badge left at home. WORN is only meaningful
// on an `equippable` tag, and db/lib/syncTags.js throws if it is set on one
// that isn't. See docs/systemdocs/TAGS.md §5.
enum TagVisibility {
  HIDDEN
  ALWAYS
  WORN
}

// Where on the body an equippable tag sits. Only three, because these are the
// places where wearing two things at once is nonsense: you get one helmet, one
// cuirass, one shield. Everything else equippable — a sword, a lantern, a cart
// — has no slot and is limited only by GameConfig.equipSlots, the flat count.
//
// HEAD and BODY additionally carry Tag.equipLayer 1-4, so a coif can go under
// a helm; SHIELD has no layers and admits exactly one. See TAGS.md.
enum EquipSlot {
  HEAD
  BODY
  SHIELD
}

enum TagSource {
  POINT_BUY
  DESIRE_REWARD
  GM_GRANT
  LEADER_GRANT
  EVENT
  // A skill learnt through a lesson (db/lib/lessonPass.js).
  LESSON
  // Made through the Craft flow (docs/systemdocs/CRAFTING.md).
  CRAFT
}

// A Request is a player-initiated change that took effect IMMEDIATELY and is
// reviewed by a GM afterwards, rather than waiting on approval first. See
// docs/systemdocs/REQUESTS.md. Adding a type here is one of the two places a
// new request kind touches (the other is web/lib/requestEffects.js).
enum RequestType {
  FULFILL_DESIRE
  ADD_TAG
  // The /store checkout: one row for a whole cart of point-buy purchases,
  // effect.items carrying every tag granted and effect.totalPoints what was
  // deducted from Character.tagPoints.
  BUY_TAGS
  REMOVE_TAG
  CONSUME_TAG
  TRANSFER_RESOURCES
  TRANSFER_TAG
  DONATE_BLOOD
  FEED_PERSON
  HEAL_CHARACTER
  CHANGE_NAME
  // A system-filed grant, not a player action — written by db/lib/cavingPass.js
  // when a Caving Die roll of 6 finds loot. PASSED by default like every
  // other request; a GM's Undo goes through the ordinary handler in
  // web/lib/requestEffects.js. See docs/systemdocs/CAVING.md.
  CAVING_LOOT
  // Looting a living but incapacitated player (dying/catatonic/paralyzed/
  // bound) in the filer's zone — tags and/or ⬢ taken in one request. See
  // db/lib/incapacitation.js and REQUESTS.md.
  LOOT_CHARACTER
  // Moving a character who follows the filer: a Leader moving a faction
  // member, or anyone dragging a body or a helpless one (bound, dying,
  // paralyzed, catatonic — db/lib/incapacitation.js). DB write happens in the
  // request transaction; the Discord zone-role swap happens after commit
  // (ARCHITECTURE.md §5 — no network call inside a transaction).
  MOVE_CHARACTER
  // Putting the `bound` tag ON someone in the filer's zone, and taking it off
  // again. Nothing else in the game grants Bound — it is the one helpless
  // state a player can inflict deliberately, and LOOT_CHARACTER,
  // MOVE_CHARACTER and HARM_CHARACTER all accept it — so these two are what
  // make that whole loop playable by players instead of by a GM.
  BIND_CHARACTER
  FREE_CHARACTER
  // Hurting someone already helpless: an affliction inflicted, a kill flagged,
  // or both in one act. Like FEED_PERSON it NEVER kills — effect.lethal only
  // raises the ☠ and the GM's Kill button. See REQUESTS.md §5b.
  HARM_CHARACTER

  // Putting a body in the ground. Removes the Cursed Discord role from the
  // dead player's account, which is the one request whose real effect lands
  // on Discord rather than on a sheet, and sets Character.buriedAt so the
  // corpse stops being lootable. The target is TYPED, not picked — first name
  // only, and only a body in the filer's own zone. See REQUESTS.md §5d.
  BURY_CHARACTER
  // Memorialising someone whose body nobody can find. Everything BURY_CHARACTER
  // does to the soul — buriedAt, and the Cursed role lifted off the dead
  // player's account — for 4 ⬢ and a Routine instead of a body, and it leaves a
  // Headstone tag behind. This is the one that kept Bury's TYPED first name,
  // since without a corpse to point at there is nothing to pick from.
  ENGRAVE_HEADSTONE
  // Cutting a corpse up for what is in it: a Nekker, Graga or Skinless for its
  // organ, a person for Human Flesh. Gated on the `butcher` tag, free in both
  // ⬢ and Moves, and it CONSUMES the corpse — which for a person's corpse also
  // means the body stops being lootable. See docs/systemdocs/CORPSES.md.
  BUTCHER_CORPSE
  // Riding a horse one zone over without spending the Move. The only request
  // that changes a zone and files no Action; the once-a-day limit lives on
  // Character.fastTravelTurnId. Gated on the `horse` or `wild-horse`
  // tag, whose catalog text is what this implements. See REQUESTS.md §5d.
  FAST_TRAVEL

  // The Merchant's Depot counter (DEPOT.md). BUY and SELL are wholesale
  // against the orbital station: Tag.depotPrice is what it charges him,
  // Tag.sellablePrice what it pays him, and only the holder of
  // `merchants-license` standing at the Depot may file either. CREDIT draws or
  // repays against the Company's line, tracked on Depot.debtObols. None of the
  // three is GM-editable — a partial edit would desync the money from the
  // stock — so Undo is the only correction.
  DEPOT_BUY
  DEPOT_SELL
  DEPOT_CREDIT

  // The Depot rework's five. Everything here is denominated in obols (¢), not
  // ⬢, and every one of them moves the Depot singleton's account rather than
  // a character's resources — the licence is tradeable, so the money belongs
  // to the station, not to whoever is holding the card this week.
  //   ORDER      — a manifest bought off the orbital station. Debits the
  //                account at order time; the goods do not exist yet.
  //   SHIP       — the shuttle sent back up, loaded. Sweeps the landing pad
  //                stash and credits the account with what was aboard.
  //   ATM        — obols withdrawn from or deposited into the account, which
  //                is the only place physical ¢ enters or leaves the game.
  //   CRATE_OPEN — a crate cracked, its contents handed over. Filed by
  //                whoever opened it, which need not be the Merchant.
  //   REFUEL     — coal or saltpeter fed to the generator.
  // Ledger reads all eight DEPOT_* kinds off Request; there is no separate
  // ledger table, and Undo works on these the way it works on anything else.
  DEPOT_ORDER
  DEPOT_SHIP
  DEPOT_ATM
  DEPOT_CRATE_OPEN
  DEPOT_REFUEL
  // ⬢ across the counter, both directions, no spread. The one place the
  // Merchant turns his own Resources into money and back. One obol IS one ⬢,
  // so it changes the form of a value rather than the amount, and there is no
  // rounding for a margin to hide in.
  DEPOT_EXCHANGE

  // One written letter, carried by a bird to a named person in a GUESSED
  // zone. Gated on holding both `bird` and `literate`; the once-a-day limit
  // lives on Character.birdTurnId, the same claim-token shape FAST_TRAVEL
  // uses. The request carries the PLAINTEXT body, because the DM it produces
  // is otherwise a private channel between two players that no GM can read.
  // Not undoable in the real sense — a sent DM cannot be recalled, so Undo
  // hands back the day and says so. See BIRD.md.
  BIRD_MESSAGE

  // The Godard Factory's two verbs (docs/systemdocs/FACTORY.md).
  //   EXTRACT_GODFLESH — cutting Godflesh out of a marsh tile. Spends the
  //                      Routine, rolls a d6, and on a 1 rolls again on an
  //                      injury table that Armored Gloves dominate.
  //   PACKAGE_ITEMS    — packing up to 150 lb of held goods into one crate,
  //                      halving their weight. The crate is a runtime Tag,
  //                      the same shape db/lib/depotCrates.js mints.
  EXTRACT_GODFLESH
  PACKAGE_ITEMS

  // Breaking the wax on a sealed letter (docs/systemdocs/PAPERWORK.md). Filed
  // through the Consume button, but its own type because it cannot go through
  // consumesInto: that field names catalog SLUGS, and the letter inside a
  // sealed one is a runtime row no slug in docs/tags.yaml could ever name.
  //
  // Undoable, and exactly: the letter is resealed and the spent envelope taken
  // back, so the only trace is the Request row itself.
  BREAK_SEAL

  // RETIRED, and kept only because Postgres cannot drop an enum value in
  // place — the same reason MoveReviewStatus.WAITING_FOR_OPPONENTS and
  // ActionStatus.ADJUDICATED are still here. Nothing writes any of these.
  //   CREATE_TAG    — a player inventing an Item that wasn't in the catalog.
  //                   Player-facing tag creation is gone; /gm/dev/tags is
  //                   still the GM's way to author one.
  //   DROP_ITEM /   — the zone cache, an Item put down where anyone standing
  //   PICK_UP_ITEM    in the zone could take it. The ZoneCache table it rode
  //                   on has been dropped.
  // requestLabels.js still names all three so a row filed before the removal
  // reads as prose; there is no REQUEST_EFFECTS entry behind them, so such a
  // row can be seen but not undone.
  CREATE_TAG
  DROP_ITEM
  PICK_UP_ITEM
}

// PASSED is the default and means "not yet touched by a GM" — the request
// stands as the player made it. EDITED/UNDONE are both terminal GM verdicts.
enum RequestStatus {
  PASSED
  EDITED
  UNDONE
}

// ACTIVE is legacy — the 2026-09-02 retroactive rework removed set/cancel, so
// a Desire row is created FULFILLED and nothing ever writes ACTIVE again. Kept
// in the enum rather than dropped, same posture as
// MoveReviewStatus.WAITING_FOR_OPPONENTS. CANCELLED still means something: a
// claim a GM revoked, or one undone through the Request system.
enum DesireStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

// What an ArchiveEntry row records. MESSAGE is a proxied character message;
// everything else is a system event written by game logic, so the two
// interleave chronologically in /archive and the transcript reads as a diary
// rather than a chat log with no context.
enum ArchiveKind {
  MESSAGE
  TURN_START
  CHARACTER_CREATED
  DEATH
  DESIRE_FULFILLED
  LIFEWEB
  TRAVEL
}

model GameConfig {
  id                         Int      @id @default(1)
  lifewebBlood               Int      @default(100)
  lifewebDecayPerTurn        Int      @default(10)
  nextWeather                Weather?
  nextTurnNote               String?
  // No longer written or read (TURN-ENGINE.md) — the rolling-replace
  // announcement these three backed has been retired. Kept until a
  // post-wipe cleanup migration.
  turnsAnnouncementChannelId String?
  turnsAnnouncementMessageId String?
  turnsBannerMessageId       String?

  // Gates the whole Dawn message-wipe system (db/lib/dawnWipe.js) — off by
  // default so nothing gets swept until a GM explicitly opts in from the
  // Dev Panel.
  messageWipeEnabled Boolean @default(false)

  // How long a character waits between two walks from one Location to
  // another inside the same zone (db/lib/locationTravel.js). Edited on
  // /gm/dev. Crossing into another zone is gated by the Move, not by this.
  locationMoveCooldownSeconds Int @default(60)

  // Capitalizes the first letter of each sentence in Tupper-proxied messages
  // before they're reposted (bot/src/lib/textCorrection.js) — on by default,
  // purely cosmetic, never touches anything but sentence-start casing.
  tupperAutocorrectEnabled Boolean @default(true)

  // Gates the "{base} | Character Name" Discord nickname sync
  // (bot/src/lib/nickname.js, web/lib/discordGuild.js#syncCharacterNickname)
  // — off by default so nobody's nickname is touched until a GM opts in.
  nicknameSyncEnabled Boolean @default(false)

  // Whether players can reach /archive. GMs always can. Off by default and
  // meant to stay off until the game ends: the archive shows every location
  // regardless of where a character was, and renders a concealed message as
  // "Alias (Real Name)" — so turning it on mid-game retroactively unmasks
  // every /conceal ever used and hands everyone the whole map's history.
  // Effectively a one-way door; the Dev Panel confirms before flipping it.
  archiveVisible Boolean @default(false)

  // Whether arrivals/departures are recorded as TRAVEL rows in the archive.
  // Off by default: it's what makes a location read like a story, and also
  // what drowns the transcript at 100+ players (two rows per character per
  // turn before anyone says a word).
  archiveTravelEvents Boolean @default(false)

  // The anchor message in #turns carrying the Travel / Move / Speak buttons
  // (see bot/src/lib/turnsConsole.js) — same tracked-message pattern as
  // turnsAnnouncement* above, but reused across restarts rather than
  // reposted, since it is a console rather than an announcement.
  //
  // These are the old locationPrompt* columns, renamed. The #location channel
  // and its ⚜ picker were retired; the columns were kept because they hold
  // exactly the same thing for exactly the same reason.
  turnsConsoleChannelId String?
  turnsConsoleMessageId String?

  // --- Discord REST circuit breaker, persisted -------------------------
  //
  // Cloudflare counts 401/403/429 responses per egress IP and bans the token
  // for about an hour at 10,000 in a rolling 10 minutes. db/lib/discordRest.js
  // trips a breaker at a tenth of that, and its own header names the threat it
  // exists for: an unattended crash-restart loop replaying the ready burst.
  //
  // Which is the one thing an in-memory counter can never catch. The counters
  // lived in module-level JS, so every restart zeroed them while Cloudflare's
  // count — keyed on the IP, not the process — carried straight on. The loop
  // the breaker was written to stop was the loop it was structurally
  // guaranteed to miss, and the health line printed at bot startup could only
  // ever read 0/1000.
  //
  // Kept here for the same reason turnsConsoleMessageId is: it is Discord
  // state that has to survive a restart and be shared by the bot and web
  // containers, which sit behind one egress IP and were each counting their
  // own fraction of the traffic against a whole-IP ceiling.
  //
  // The in-memory array stays the hot path — this is read once per process and
  // written only on the error path, never per request.
  restInvalidCount       Int       @default(0)
  restInvalidWindowStart DateTime?
  restBreakerOpenUntil   DateTime?

  // Multiplier applied to every rate in db/lib/production.js's
  // PRODUCTION_RATES table — read live by the Labor checkbox
  // (db/lib/laborAccess.js). docs/documents.yaml renders its numbers through
  // live {resource:...} bubbles, so nothing needs regenerating when this
  // changes. See docs/systemdocs/LABORING.md.
  //
  // Default is 0.93, not 1: laboring was brought down about 7% before launch.
  // Note what that does NOT reach — Basic is in UNSCALED_TIERS on purpose, and
  // Skilled's 1-4 rounds back to 1-4, so the cut lands on the three
  // specialisations, which is where the volume is.
  productionCoefficient Float @default(0.93)

  // Base point-buy budget every new character starts with, before the
  // role's own `extra_starting_points` and the Cursed penalty are applied
  // (see web/lib/characterCreation.js#computeBudget). Editable live from
  // the Dev Panel so it can be tuned right up to launch.
  startingTagPoints Int @default(12)

  // Master switch for the game being open to players at all. While false,
  // nobody can create a character — the game has not launched. Turning it on
  // is not by itself enough: a player also has to hold DISCORD_PLAYER_ROLE_ID
  // (see web/lib/discordGuild.js#isApprovedPlayer), so the two together are
  // "the doors are open" AND "you are on the list". Deliberately off by
  // default, same posture as messageWipeEnabled.
  //
  // Note this gates character creation only. /documents stays readable
  // either way, so players can read the rules before launch.
  openToPlayers Boolean @default(false)

  // Whether a role that grants a faction Leader seat still requires the
  // @Leader Whitelist Discord role (db/lib/roleIds.js). Off means every player
  // may pick a Leader role - read by character/page.js to decide which cards
  // render selectable, and re-checked by createCharacter, the same
  // presentation/lock split as openToPlayers. Deliberately ON by default: this
  // gate fails closed, and the reservation is the normal state of the game.
  leaderWhitelistEnabled Boolean @default(true)

  // Playtest lever: locks every role in the Windlands out of character
  // creation, without removing them from docs/roles.yaml — flip it back off
  // and the full roster returns. (It used to hold the Merchant back too; the
  // Merchant Update finished that seat, so only the zone lock is left.) Which
  // roles it covers lives in web/lib/characterCreation.js
  // (PLAYTEST_LOCKED_ROLE_SLUGS / PLAYTEST_LOCKED_ZONE_NAMES), not here.
  // Off by default: this is a temporary content lock, not a permission gate,
  // so a missing config row means the whole roster is open.
  playtestModeEnabled Boolean @default(false)

  // When true, the nightly turn-advance cron (bot/src/events/ready.js)
  // skips its automatic advance — bot/src/lib/turnEngine.js#advanceTurn
  // checks this before calling into the shared engine. A GM's "Advance turn
  // now" in the Dev Panel calls the shared engine directly and is not gated
  // by this flag, so a paused game can still be force-advanced by hand. Off
  // by default: the cron runs normally unless a GM deliberately pauses it,
  // and a wipe resets this back to false along with every other operational
  // toggle here.
  autoTurnAdvanceDisabled Boolean @default(false)

  // Master switch for letting a player upload their own profile picture.
  // Off means AvatarField's file input doesn't render and
  // updateCharacterProfile ignores a posted `avatar` field even if one
  // arrives anyway — everyone falls through to their letter plaque (see
  // "Character proxying" in CLAUDE.md). Existing Character.avatarData is
  // untouched either way; this only gates new uploads. Deliberately off by
  // default, same posture as messageWipeEnabled/openToPlayers.
  avatarUploadsEnabled Boolean @default(false)

  // Master switch for the in-app portrait maker (docs/systemdocs/PORTRAITS.md).
  // Off means the "Customize Appearance" button doesn't render and
  // setPortraitAvatar refuses whatever the client posts — the same
  // presentation/lock split as avatarUploadsEnabled above. Off by default.
  portraitMakerEnabled Boolean @default(false)

  // Reveals the portrait parts the catalog marks `fantasy`: pointed ears,
  // horns, antlers, and unnatural hair and eye colours. Ravenheart is low
  // fantasy and human-only, so these are hidden rather than deleted — a GM
  // running something stranger flips this and they appear. Off by default, and
  // re-checked server-side: a portrait already wearing horns when it is turned
  // back off keeps them until its owner next saves.
  portraitFantasyPartsEnabled Boolean @default(false)

  // How many tags a character may have equipped at once. Enforced inside the
  // transaction that flips CharacterTag.equipped, so two tabs racing on the
  // last slot cannot both win. Editable live from the Dev Panel, same posture
  // as startingTagPoints above.
  equipSlots Int @default(6)

  // Carry caps: how many POUNDS of tradeable tags and how many ⬢ a character
  // can hold before they are Overburdened (docs/systemdocs/CARRY.md). Base
  // values, raised or lowered by the sum of every ACTIVE Tag.carryBonus. Going over is
  // allowed up to 1.5× (carry.js HARD_CAP_RATIO); past that the goods cannot
  // enter the sheet at all. Assets — a horse, a cart, a house — are exempt
  // from the weight load entirely. Live on /gm/dev.
  carryWeightLbs   Int @default(120)
  carryResourceCap Int @default(25)

  // Free zone crossings per character per turn, before a crossing starts
  // spending the Move (docs/systemdocs/CARRY.md §2). An equipped mount adds
  // one on top; Overburdened zeroes the allowance. Live on /gm/dev.
  freeZoneMovesPerTurn Int @default(1)

  // TWO ceilings on drawbacks at creation, and a build stops at whichever it
  // reaches first (TAGS.md §4a). Neither works alone: with a count cap only,
  // five −1s and five −11s cost the same five slots, so the cap reads as an
  // instruction to stack the heaviest tags in the catalog; with a point cap
  // only, one Appendicitis finishes you while ten −1s are never stopped.
  //
  // Both count POINT_BUY drawbacks only — a role's free drawback (the
  // Meister's Frail, the Headman's Old) arrives as GM_GRANT, and so does
  // anything a GM or a turn effect inflicts, so neither eats into a player's
  // allowance. Enforced in createCharacter, shown live as the two bars in
  // PointBuy's build pane; /store passes neither, because the caps belong to
  // the wizard and stop existing once play starts. Both are editable live
  // from the Dev Panel, same posture as equipSlots above, and 0 is a real
  // setting on either: no drawbacks at all.

  // How many drawback TAGS may be bought — a cap on the COUNT of
  // negative-cost tags picked, whatever they are worth.
  maxDrawbackTags Int @default(5)

  // How many points those drawbacks may claim back in total. Stored as a
  // POSITIVE magnitude — "at most 12 points may be claimed" — even though
  // every drawback carries a negative pointCost, so nothing has to do a sign
  // dance to compare against it. It matches startingTagPoints on purpose:
  // you can never claim back more than you started with.
  maxDrawbackPoints Int @default(12)

  // How many Desire slots a character has, each of which can be claimed into
  // once every desireSlotLockTurns turns. Same live-editable posture as
  // equipSlots above.
  desireSlots Int @default(2)

  // Whole turns a Desire slot stays shut after a Desire is claimed into it.
  // A claim on turn N leaves the slot shut on N and open again on
  // N + desireSlotLockTurns + 1 (db/lib/desireGates.js#slotStates).
  desireSlotLockTurns Int @default(2)

  // Expected total number of players, the denominator for every role's seat
  // cap: a role with `weight: 6` in docs/roles.yaml gets
  // round(6 * playerCount / 100) seats. Raising this mid-signup widens every
  // capped role proportionally without touching the YAML.
  playerCount Int @default(100)

  // The narrowcast channels (#watch, #intercom) live under a
  // shared Discord "radio" category — see db/lib/specialChannels.js.
  // Provisioned once by npm run db:sync-narrowcast-channels; never touched
  // again after that.
  radioCategoryId   String?
  watchChannelId    String?
  intercomChannelId String?
  // Orphaned: #mindlink went with the Cult of Bacchus (docs/archive/bacchus.yaml).
  // Nothing reads or writes it; kept rather than migrated away.
  mindlinkChannelId String?

  // The Catatonic (AFK) pass (db/lib/catatonicPass.js): any ALIVE character
  // with no player-filed Action and no in-character speech for
  // catatonicTurns turns straight is flagged; the flag lifts the moment they
  // act or speak again. On by default — this doesn't delete anything, it
  // just marks the sheet for a GM to see.
  catatonicEnabled Boolean @default(true)
  catatonicTurns   Int     @default(4)

  // Consecutive turns holding `catatonic-afk` before
  // db/lib/catatonicDeathPass.js kills the character outright at turn close. This is the ONE thing in the
  // engine that ends a character without a GM (TURN-ENGINE.md §2 pass 7b), so
  // it gets its own off switch: 0 disables the death pass entirely, without a
  // deploy, while leaving the flagging pass above untouched.
  catatonicDeathTurns Int @default(4)

  // How many turns a paper pinned to a noticeboard stays up before it blows
  // away, counting the turn it was pinned in. The paper is destroyed with the
  // post — a notice nobody took down is a notice nobody wanted.
  // See docs/systemdocs/PAPERWORK.md.
  noticeExpiryTurns Int @default(10)

  // Whether the bot runs the channel doctor's cheap reconciliation pass
  // (db/lib/channelDoctor.js) automatically after every turn advance, on top
  // of its pass at ready. Off by default.
  autoReconcileEnabled Boolean @default(false)

  // Master switch for players setting a NEW Desire on /character
  // (docs/systemdocs/REQUESTS.md §5). Off greys the panel and shows
  // "Temporarily disabled." in place of every slot, and blocks claimDesire
  // server-side. GMs are unaffected: awardDesireGm/revokeDesireGm on the Dev
  // Panel are host access, same split as the rest of the Discord permission
  // model. On by default, since Desires are the only way Tag Points are
  // earned in play.
  desiresEnabled Boolean @default(true)
}

/// Where the shuttle is. AWAY is the resting state — it lives at the orbital
/// station and the landing pad is an empty scorch mark. INBOUND is the gap
/// between calling it down and it arriving, which is what the cooldown buys.
/// DOCKED means it is sitting on the pad with its hold open, and the clock in
/// Depot.shuttleTurn is counting toward the automatic departure.
enum ShuttleState {
  AWAY
  INBOUND
  DOCKED
}

/// The Merchant's Depot as a machine rather than a shop: one generator, one
/// shuttle, one turret, one bank account. A singleton on id = 1, reached the
/// same way GameConfig is (`upsert({ where: { id: 1 } })`).
///
/// It is its own model rather than eighteen more columns on GameConfig for two
/// reasons. GameConfig is game-wide switchboard; this is one location's
/// hardware, and mixing them makes both harder to read. And the Dev Panel's
/// Depot section wants to render exactly these fields — a model boundary is
/// also a form boundary.
///
/// Every number here moves through db/lib/depotState.js, never a bare update:
/// the account and the fuel both clamp inside a single locked statement, the
/// way lifeweb.js#bumpBlood does, so two people spending at once cannot stomp
/// each other. See docs/systemdocs/DEPOT.md.
model Depot {
  id Int @id @default(1)

  // ─── Live state ───

  // The account. One balance for the whole station, in obols — and an obol is
  // one ⬢, so this compares directly against any price in the catalog. It is
  // NOT on the Merchant's character on purpose: the licence is tradeable, so
  // handing it over hands over the money too, which is what makes the card
  // worth stealing.
  accountObols Int @default(0)

  // Drawn against the Company's line, in obols. Repaying frees the room back
  // up immediately. Kept separate from accountObols so a Merchant deep in debt
  // still reads as having cash on hand — because he does, it just isn't his.
  debtObols Int @default(0)

  // The generator. With it off, nothing at the Depot works: no ordering, no
  // shuttle, no ATM, no turret. Fuel burns down every turn it is running, and
  // hitting zero switches it off rather than going negative.
  generatorOn   Boolean @default(false)
  generatorFuel Int     @default(0)

  // The indoor turret. It shoots everyone whose PRESENTED name is not
  // merchantFace — so a concealed Merchant is shot by his own gun, and anyone
  // wearing his name is spared. Deliberately not keyed on the keycard or the
  // role: it reads faces, and that is the whole trap.
  //
  // merchantFace is written when a character is created on the Merchant role,
  // and a GM can override it from /gm/dev. It is set once and never resynced,
  // because a face does not change when the papers do.
  turretArmed  Boolean @default(false)
  merchantFace String  @default("")

  // The shuttle, and the turn its current state began. shuttleTurn is what
  // both clocks read: the cooldown before it can be sent back, and the
  // automatic departure at shuttleMaxTurns.
  shuttleState ShuttleState @default(AWAY)
  shuttleTurn  Int?

  // What has been ordered but not yet flown down. A JSON array of
  // `{ tagId, quantity, unitPrice }`, paid for at order time and turned into
  // crates when the shuttle lands. Not a table because it is short-lived, is
  // only ever read whole, and belongs to exactly one row.
  manifest Json @default("[]")

  // ─── Tunables, all editable from the Dev Panel's Depot section ───

  fuelMax         Int @default(100)
  fuelBurnPerTurn Int @default(20)
  coalFuel        Int @default(50)
  saltpeterFuel   Int @default(15)

  shuttleMaxTurns Int @default(6)
  shuttleCooldown Int @default(1)

  creditCapObols Int @default(75)

  // The turret's severity distribution, one weighted column per armour tier.
  // JSON rather than columns because a GM retuning it should not need a
  // migration, and db/lib/depotTurret.js validates the shape and that every
  // column sums to 1 at startup — the same posture as cavingLoot.js.
  turretTable Json @default("{}")

  updatedAt DateTime @updatedAt
}

// Master-sourced from docs/roles.yaml's zones[].factions[]
// (db/lib/syncRoles.js#syncRolesFromYaml, npm run db:sync-roles), then LIVE:
// players found factions, rename them, secede from a parent and move between
// them, so nothing here is safe to re-derive from the YAML.
//
// `slug` is the stable match key and the ONLY thing code may branch on --
// `name` is player-editable (db/lib/factionConstants.js#isUnaffiliated).
model Faction {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Where this faction banks: a Room, whose own `resources` and RoomTag
  // stacks ARE the silo (CARRY.md, FACTIONS.md). There is no faction-level
  // balance -- a Silo model existed until 9/2026 and is not coming back.
  // Seeded create-only from roles.yaml's `silo:`, then owned by the faction's
  // officers. SetNull, so pruning a room in db:sync-zones unpoints the silo
  // rather than cascading the faction away.
  siloRoomId String?
  siloRoom   Room?   @relation("FactionSilo", fields: [siloRoomId], references: [id], onDelete: SetNull)

  // The character who founded this faction in play; null for every faction
  // the YAML authored. Kept as a plain id rather than a relation: the founder
  // can die, leave or be deleted, and none of that should touch the faction.
  foundedById String?

  applications FactionApplication[]

  // The Zone this faction belongs to, from its nesting in roles.yaml. Groups
  // the character-creation role picker (Zone -> Faction -> Role) and labels
  // the faction on every ZoneChip surface. Members are not confined to it.
  zoneId String?
  zone   Zone?   @relation("FactionHomeZone", fields: [zoneId], references: [id])

  // Authoring order within the zone, so the picker lists factions the way
  // roles.yaml does rather than alphabetically.
  sortOrder Int @default(0)

  roles Role[]

  // Nesting, for the role picker and the roster. Membership/leadership
  // administration stays same-faction only.
  parentFactionId String?
  parentFaction   Faction?  @relation("FactionHierarchy", fields: [parentFactionId], references: [id])
  subjectFactions Faction[] @relation("FactionHierarchy")

  characters Character[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One live handshake between a character and a faction, in whichever
// direction it was opened. Deliberately NOT a Request (REQUESTS.md): a
// Request lands immediately and is reviewed afterwards, carrying an applied
// `effect` snapshot, and an application's whole nature is that it sits
// pending until somebody answers it.
enum FactionApplicationKind {
  // The character knocked. Any officer of the faction answers.
  APPLICATION
  // An officer knocked. The named character answers.
  INVITE
}

enum FactionApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  // Pulled back by whoever opened it -- including automatically, when the
  // applicant joins somewhere else or dies.
  WITHDRAWN
}

model FactionApplication {
  id String @id @default(cuid())

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  kind   FactionApplicationKind
  status FactionApplicationStatus @default(PENDING)

  // What the applicant or the inviting officer wrote. Free text, shown to the
  // other side verbatim.
  note String @default("")

  // Who answered and when are deliberately NOT columns here. Every decision
  // already writes an AuditLog row naming the actor, and `updatedAt` below is
  // the timestamp -- two more fields nothing read would have been state
  // stored twice.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId, status])
  @@index([characterId, status])
}

// A region of the map: a Discord category, its #summary channel and the
// "Zone: {Name}" role. Since Bascinet 2 a character STANDS in a Location
// (below), not in a zone; Character.zoneId is kept equal to
// location.zoneId because dozens of readers group by it. Mastered by
// docs/zones.yaml (db/lib/syncZones.js, npm run db:sync-zones), which is
// destructive both ways, matched on `slug`.
//
// Access is ONE Discord guild role per presence zone ("Zone: Town",
// discordRoleId below) opening #summary, #turns and #intercom, plus one
// "Location: {Name}" role per Location opening that Location's channel.
// Moving a character is a role swap, and every channel carries a handful of
// role overwrites instead of one per member. That is what makes drift cheap
// to detect and repair — see db/lib/channelDoctor.js.
//
// kind decides the Discord footprint (see ZoneKind above). seatZoneId is the
// denormalized GM-seat key: parentZoneId ?? id, written by the sync. Every
// query that groups by "which GM's table does this belong on" — factions,
// GmAssignment, Action/Note/StagedMessage stamping — filters on
// seatZoneId, so the four GM seats stay four while presence is six. Writers
// stamp it via db/lib/seatZone.js#seatZoneIdFor, never by hand.
//
// There is no zone-level travel graph any more: the graph is between
// Locations (Location.connectsTo), and a hop whose edge crosses a zone
// boundary is what costs the character's Move.
model Zone {
  id   String @id @default(cuid())
  slug String @unique
  name String

  kind ZoneKind @default(SURFACE)

  // Authoring order from the YAML, so category sorting and pickers match the
  // file rather than the alphabet.
  sortOrder Int @default(0)

  // The short blurb heading the zone's "Create a Topic" post. One or two
  // sentences ("A fertile valley.").
  description String @default("")

  // Self-parent: only CAVE_LEVEL rows set it, pointing at the CAVE_GROUP.
  parentZoneId String?
  parentZone   Zone?   @relation("ZoneNesting", fields: [parentZoneId], references: [id])
  childZones   Zone[]  @relation("ZoneNesting")

  // parentZoneId ?? id — see the model comment. A single equality, no
  // recursion, for every seat-scoped query.
  seatZoneId  String?
  seatZone    Zone?   @relation("ZoneSeat", fields: [seatZoneId], references: [id])
  seatedZones Zone[]  @relation("ZoneSeat")

  // Discord footprint. Null until provisioned by the sync (create-only,
  // keyed on discordCategoryId being null — names are one-time; renaming a
  // zone in the YAML does not rename live channels). SURFACE gets a category
  // and #summary; CAVE_GROUP only the category; CAVE_LEVEL neither — its
  // Location channels parent to the group's category.
  discordCategoryId       String?
  discordSummaryChannelId String?

  // The zone's access role ("Zone: Town"). Held by every character standing
  // in any of its Locations; grants ViewChannel on #summary (and, via
  // db/lib/turnsChannelAccess.js and the #intercom registry, on the standing
  // channels). Permissions 0, color 0, never hoisted or mentionable.
  discordRoleId String? @unique

  // Clickable region on the /map plate: a polygon of [x, y] percentage pairs
  // (0-100 of the 4:3 plate, origin top-left), plus where the label sits.
  // Json because a region is a variable-length point list. Null/empty means
  // the zone draws nothing (the CAVE_GROUP row).
  mapPolygon Json?
  mapLabelX  Float?
  mapLabelY  Float?

  locations        Location[]
  factions         Faction[]       @relation("FactionHomeZone")
  characters       Character[]
  actions          Action[]
  notes            Note[]
  gmAssignments    GmAssignment[]
  stagedMessages   StagedMessage[]
  startingForRoles Role[]          @relation("RoleStartingZone")
  cavingRolls      CavingRoll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seatZoneId])
  @@index([parentZoneId])
}

/// Which zones a GM is the seat for. The game runs with one master (the
/// superadmin, web/lib/superadmin.js) plus zone-GMs seated over the four SEAT
/// zones -- Town, Fortress, Windlands and Caves. Never a cave level: the three
/// levels of the Depths all belong to the Caves seat via Zone.seatZoneId, so a
/// row here pointing at a CAVE_LEVEL would be a seat nothing is ever stamped
/// with. The server action refuses one.
///
/// ONE ROW PER SEAT. A GM may hold several at once (five GMs, four zones, and
/// somebody covers two), so the primary key is the pair. Absence of any row is
/// "no seat", which is also the master's state and reads as All.
///
/// Keyed on discordUserId rather than hung off Character, because a GM may
/// never roll one -- and should not lose their seat when theirs dies.
///
/// The near-miss alternative was a nullable Zone.gmDiscordUserId: one column,
/// no new table. It was rejected because a zone can then hold only one GM, and
/// assignment becomes clear-everywhere-then-set: a two-statement write whose
/// partial failure leaves a seat orphaned. The join table makes the set of
/// seats the unit of the write, replaced wholesale in one transaction.
///
/// This is a SOFT gate and the only one in the app that is: it picks the
/// default filter on the GM tables, it hides nothing. See CLAUDE.md's Discord
/// permission model table.
model GmAssignment {
  discordUserId String
  zoneId        String
  zone          Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  /// Snapshot of the superadmin who set it, per the log-table convention --
  /// no FK, so it survives the actor leaving the guild.
  assignedByDiscordUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([discordUserId, zoneId])
  @@index([zoneId])
  @@index([discordUserId])
}

/// Where a character STANDS — the unit of presence and channel access since
/// Bascinet 2. One Discord text channel per Location under its zone's
/// category. A Location wears NO Discord role: the channel is opened to
/// whoever is standing in it by a per-member permission overwrite, written by
/// db/lib/locationMove.js and reconciled by the channel doctor's
/// location-occupancy check. 56 locations would otherwise have cost 56 of the
/// guild's 250 roles on top of one personal role per living character;
/// Discord allows 1000 overwrites per channel instead. Its Rooms are threads
/// under that channel. Mastered by docs/zones.yaml's per-zone `locations:`
/// maps (db/lib/syncZones.js); everything Discord-side is create-once and
/// reconciled every run, the way zones are.
///
/// linksA/linksB are the two halves of the undirected travel graph, which is
/// LocationLink — see that model. A hop between two Locations of the same
/// zone is free (on the GameConfig.locationMoveCooldownSeconds cooldown); a
/// hop whose edge crosses into another zone costs the Move, exactly as zone
/// travel used to.
// The three specialised labor types. A Location carries one LocationYield row
// per kind it supports; no row at all means that kind is impossible there,
// which is what the Labor? button prints as a bare "x".
enum LaborKind {
  HUNTING
  FARMING
  FISHING
}

// What one Location yields for one labor type, and how far it has drifted from
// what docs/zones.yaml authored. One row per (location, kind) - at most 168 of
// them, and only for kinds the location actually supports.
//
// Split out of Location rather than added as columns because the drift pass
// (db/lib/laborYield.js) wants one uniform row shape to walk, and nine columns
// plus six of drift state would have made Location unreadable for a concept
// that only laboring cares about.
model LocationYield {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       LaborKind

  // Authored in docs/zones.yaml's per-location `yield:` block and pushed by
  // db:sync-zones. The value `current` reverts toward.
  base Float

  // The live coefficient, re-drifted at every turn close. This is what a
  // payout multiplies by and what the Labor? button reads - never `base`.
  current Float

  // An active swing. While set and unexpired, `current` reverts toward
  // `eventTarget` instead of `base`; when the window passes both are cleared
  // and the ordinary reversion walks it home on its own.
  eventTarget    Float?
  eventUntilTurn Int?

  updatedAt DateTime @updatedAt

  @@unique([locationId, kind])
}

model Location {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // The -# subtext under the name on the channel's anchor message, and the
  // channel topic.
  description String @default("")

  // Authoring order within the zone, from the YAML — channel order under the
  // category and picker order.
  sortOrder Int @default(0)

  // A place you walk INTO: the Cathedral, the Sanctuary, the Inn, the Keep,
  // the Undercroft, the Factory. A cart or a mount is unequipped on arrival
  // (db/lib/locationMove.js) and cannot be equipped while you stand here, so
  // its carry bonus is parked at the door with it. Authored as `indoors: true`
  // in docs/zones.yaml; the anchor message says so in its own -# line.
  indoors Boolean @default(false)

  // What else is true about this place, authored as docs/zones.yaml's
  // per-location `attributes:` map. A flat JSON object of registry keys from
  // db/lib/locationAttributes.js, which is the only thing that should read it
  // — the sync rejects a key that module does not know, so a typo is a loud
  // problem rather than a line that never prints.
  //
  // JSON rather than a column per fact because these are sparse, additive and
  // player-facing prose triggers, not things anything queries or indexes on.
  // `indoors` stays a real column precisely because it IS queried
  // (db/lib/indoors.js, db/lib/mounts.js); it is merely rendered alongside
  // these.
  attributes Json @default("{}")

  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  // Both halves of the undirected travel graph. Never read directly: go
  // through db/lib/locationGraph.js, which normalises the two sides into one
  // neighbour list and applies each link's gating.
  linksA LocationLink[] @relation("LinkA")
  linksB LocationLink[] @relation("LinkB")

  // The Location's text channel, null until provisioned.
  discordChannelId String?

  // The pinned anchor message (name, description, the Public Rooms index and
  // the Who's here? / Secret rooms? / Converse buttons), content-hash
  // reconciled so a no-op re-sync makes zero Discord calls.
  anchorMessageId String?
  anchorHash      String?

  rooms            Room[]
  characters       Character[]
  playerThreads    PlayerThread[]
  startingForRoles Role[]          @relation("RoleStartingLocation")
  yields           LocationYield[]
  noticePosts      NoticePost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Moves filed while standing here (Action.locationId).
  actions      Action[]
  threatSpawns ThreatSpawn[]

  @@index([zoneId])
}

/// One edge of the travel graph, mastered by docs/zones.yaml's `connections:`.
///
/// Undirected, and stored as ONE row rather than a mirrored pair: aId/bId are
/// held in ascending Location.slug order by the sync, so an attribute cannot
/// disagree between the two directions and a modular gate cannot end up open
/// one way and shut the other. Readers must therefore match on either side —
/// db/lib/locationGraph.js is the only thing that should ever do so.
///
/// The behaviours compose rather than enumerate, because one real edge on the
/// map (the Gatehouse to the Road) is a manned gate AND a modular one:
///
///   announce         GATE / UNMANNED GATE. Posts into the destination zone's
///                    #summary on crossing — TRUE_NAME with the traveller's
///                    real name, CONCEALED with only their concealed alias.
///   requiredTagSlug  LOCKED. Crossing needs this tag. Held as a slug, not an
///                    FK, because tags sync AFTER zones and an FK would make
///                    the master unloadable in the working order; db:doctor
///                    validates it instead.
///   hidden           HIDDEN. requiredTagSlug plus omission from the travel
///                    list, so a player without the tag never learns the edge
///                    is there.
///   modular          An Open/Close button on both endpoints' anchors.
///                    Impassable while isOpen is false. openerRoleSlugs are
///                    Role slugs from docs/roles.yaml and openerTagSlugs are
///                    Tag slugs; holding any one of them is authority to
///                    flip it.
///   onFoot           Too tight, too steep or too enclosed for a horse or a
///                    cart. A MOUNTED character is refused at the threshold —
///                    which is the point, because Location.indoors only parks
///                    a mount on ARRIVAL, and by then the rider has already
///                    spent the extra free zone-crossing an equipped mount
///                    buys (freeZoneMoves, db/lib/locationTravel.js). This is
///                    the edge-level sibling of indoors: same effect, earlier
///                    moment. Unequipping the horse is the way through.
///   keyed            On crossing, the key-holder is DM'd "Leave open for the
///                    next 24 hours?". Yes stamps openUntil, and until then
///                    the edge ignores requiredTagSlug AND is listed even when
///                    hidden — which is the point: it is how somebody without
///                    the key can follow you through. Nothing closes it; the
///                    check just compares openUntil against now.
model LocationLink {
  id String @id @default(cuid())

  aId String
  bId String
  a   Location @relation("LinkA", fields: [aId], references: [id], onDelete: Cascade)
  b   Location @relation("LinkB", fields: [bId], references: [id], onDelete: Cascade)

  announce LinkAnnounce @default(NONE)

  requiredTagSlug String?
  hidden          Boolean @default(false)

  modular         Boolean  @default(false)
  isOpen          Boolean  @default(true)
  openerRoleSlugs String[]
  openerTagSlugs  String[]

  keyed     Boolean   @default(false)
  openUntil DateTime?

  onFoot Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aId, bId])
  @@index([bId])
}

/// What crossing a gate announces in the destination zone's #summary.
enum LinkAnnounce {
  NONE
  TRUE_NAME
  CONCEALED
}

/// A thread under a Location's channel, sync-owned: the starter message is the
/// room's description, the Dawn wipe empties the thread down to that starter,
/// and nothing player-facing can create, delete or unwipe one. PUBLIC rooms
/// are public threads; PRIVATE rooms are private threads whose membership is
/// exactly "holds one of accessTagSlugs", reconciled by db/lib/roomAccess.js
/// on every arrival and tag change. Mastered by docs/zones.yaml's per-location
/// `rooms:` maps.
model Room {
  id   String @id @default(cuid())
  slug String @unique
  name String

  description String @default("")

  // Authoring order within the location, from the YAML.
  sortOrder Int @default(0)

  kind RoomKind @default(PUBLIC)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Tag slugs, any of which admits a character to a PRIVATE room. Slugs, not
  // FKs, because the room is authored against docs/tags.yaml's fixed
  // identifiers and the two syncs run independently. Empty for PUBLIC.
  accessTagSlugs String[] @default([])

  // A room that eats what is put into it. Set from `destroys: true` in
  // docs/zones.yaml; the Godard Factory's Spillway is the only one. A
  // Transfer whose destination carries this never writes a RoomTag or touches
  // Room.resources — the lines are recorded on the request's effect instead,
  // so a GM can still Undo. See docs/systemdocs/CARRY.md.
  destroysContents Boolean @default(false)

  // The thread, its starter message (a thread in a text channel has an
  // ordinary first message with its own id — only a forum post's starter
  // shares the thread id) and the body hash last written.
  discordThreadId  String?
  starterMessageId String?
  postHash         String?

  // The stash. ⬢ left lying in this room, moved only through
  // db/lib/resourceTransfer.js#moveParty with a `room:` party, and the tag
  // stacks below. Unlimited on purpose — a room is where you put what you
  // can't carry (docs/systemdocs/CARRY.md).
  resources Int       @default(0)
  tags      RoomTag[]

  playerThreads PlayerThread[]
  guests        RoomGuest[]

  // Factions banking here. A list rather than a single back-reference because
  // nothing stops two factions sharing a room -- the Church and the Order
  // both sit in the Cathedral.
  siloOf Faction[] @relation("FactionSilo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
}

/// One stack of a tag lying in a Room. No per-room limit, and unlike
/// CharacterTag there is no non-stackable pin: two players can each leave a
/// Longbow here and the row goes to 2 — the pin is a rule about what one
/// CHARACTER can hold, re-applied on the way out by tagWrites.js#addToStack.
/// `expiresTurn` rides along from the holder's row so stashing a meal can't
/// stop it rotting; the sweeps in db/index.js shed it the same way.
// A paper pinned to a Location's noticeboard. See
// docs/systemdocs/PAPERWORK.md.
//
// Its own table rather than a RoomTag, for three reasons. A noticeboard is a
// LOCATION fixture and only Rooms carry stashes. A post needs its own clock,
// which RoomTag.expiresTurn could have carried but nothing sweeps for a room.
// And a pinned notice must not show up in the Storage readout — a board is
// public by nature and a stash is not.
//
// tagId is @unique: the paper is ON the board or it is in somebody's hands,
// never both. Pinning moves the CharacterTag row here; tearing moves it back.
model NoticePost {
  id String @id @default(cuid())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  tagId String @unique
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Who put it up, for the GM's benefit and for the ambient line. Nullable and
  // SetNull, because a notice outlives the person who pinned it — that is
  // rather the point of nailing something to a wall.
  postedById String?
  postedBy   Character? @relation("NoticePostAuthor", fields: [postedById], references: [id], onDelete: SetNull)

  postedTurn  Int
  // Absolute turn number, the same convention as CharacterTag.expiresTurn, and
  // computed through db/lib/turnFormat.js#expiryFrom so N turns means N turns
  // counting the one it was pinned in. Swept by db/lib/noticeboardPass.js,
  // which destroys the paper with the post — it blew away.
  expiresTurn Int

  createdAt DateTime @default(now())

  @@index([locationId])
  @@index([expiresTurn])
}

model RoomTag {
  id String @id @default(cuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  quantity    Int  @default(1)
  expiresTurn Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, tagId])
  @@index([tagId])
  @@index([expiresTurn])
}

/// A Conversation: the one kind of thread a player can open, from the
/// Converse button on a Location's anchor. A private thread under the
/// Location's channel, linked to one of its Rooms — every 15 minutes the
/// linked room hears who is whispering in it (bot/src/lib/whisperPoll.js).
/// Deleted at every Dawn, no exceptions; there is no persistence any more.
/// The bot is the ONLY creator (players hold no create-thread permission),
/// so this table is complete.
///
/// Creator fields are snapshots, not FKs — the thread outlives a dead or
/// wiped character, same posture as the log tables.
model PlayerThread {
  id       String @id @default(cuid())
  threadId String @unique
  name     String

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // The room the whispering is heard in. Set-null rather than cascade: a
  // room pruned from the YAML mid-day shouldn't destroy a live conversation.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  creatorCharacterId   String?
  creatorDiscordUserId String?

  // Written by the bot's messageCreate (debounced to one write per thread
  // per turn). Informational since Bascinet 2 retired inactivity expiry.
  lastActivityTurn Int?
  lastActivityAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([lastActivityTurn])
}

/// Who /add has invited into a conversation. Discord's thread-member list
/// is the live truth, but it refuses (or loses) a member who can't currently
/// view the parent channel — which is exactly what /add supports: invite
/// anyone, they see the thread when they reach the Location. So the invite is
/// recorded here and re-applied by applyPendingInvites whenever the character
/// arrives in the Location, in the same pass that swaps their location role.
///
/// threadId deliberately carries no FK to PlayerThread so the doctor can
/// clean the two independently; characterId is a plain id for the same
/// reason.
model PlayerThreadInvite {
  threadId    String
  characterId String

  createdAt DateTime @default(now())

  @@id([threadId, characterId])
  @@index([characterId])
}

/// One character let into one private Room by hand rather than by holding a
/// key — the Baron waving somebody into his office. A private Room's
/// membership is otherwise pulled entirely from Room.accessTagSlugs
/// (db/lib/roomAccess.js), and this is the one exception.
///
/// The grant is SPENT WHEN THEY LEAVE. syncCharacterRoomAccess deletes every
/// row whose Room is not where the character now stands, and it already runs
/// on every arrival, so walking out of the Location is what closes the door.
/// That is why a guest is a row rather than a thread-member add and nothing
/// else: Discord's member list survives a move, and the rule must not.
///
/// Real FKs both ways, unlike PlayerThreadInvite — a Room and a Character are
/// both rows here, so the cascade is free and there is nothing for the doctor
/// to reconcile except a guest who wandered off.
model RoomGuest {
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Who opened the door, for the audit trail. Snapshot id, not an FK — the
  /// inviter may be dead by the time anyone reads it.
  invitedById String?

  createdAt DateTime @default(now())

  @@id([roomId, characterId])
  @@index([characterId])
}

/// The outcome of a long-running operational pass that runs in after() or a
/// side-effect thunk — Restart Game, the channel doctor, the Dawn wipe, a GM
/// bulk move — where the UI has already returned "ok" long before the work
/// finishes. The Dev Panel shows the latest report per kind instead of
/// claiming a success it cannot know about. A row with finishedAt null is
/// itself the signal: the container died mid-pass.
model SystemReport {
  id   String           @id @default(cuid())
  kind SystemReportKind

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)

  actorDiscordUserId String?

  /// { steps: [{ name, ok, detail?, message? }], ... } — one entry per step,
  /// in execution order.
  summary Json @default("{}")

  /// [{ step, target?, message }] — every failure, never truncated to a
  /// count.
  failures Json @default("[]")

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model Character {
  id            String @id @default(cuid())
  discordUserId String

  // A displayed name is four parts, joined by
  // db/lib/characterName.js#formatCharacterName as
  // `Sir Jorren "the Blind" Vask`. `honorific` is EARNED, not picked: a tag
  // the character holds or the role they took grants the word, and `gender`
  // below decides which form of it they wear (db/lib/titles.js). `title` is
  // GM-only and renders in quotes — no player-facing form ever reads it,
  // which is the whole lock. Most characters carry neither.
  honorific String?
  firstName String
  title     String?
  lastName  String?

  // Chosen once, on the last step of creation, and never editable afterwards:
  // character/actions.js#updateCharacterProfile simply doesn't read the key,
  // which is the lock — the same silence that keeps a name immutable, not the
  // null-until-set conditional `age` below uses. A GM can still correct one
  // from /gm/dev/characters/[characterId].
  //
  // Four seats fix it rather than letting the player choose: Baron and Heir
  // are MAN, Baroness and Successor are WOMAN, declared as `gender:` in
  // docs/roles.yaml and carried on Role.lockedGender. Those are the same four
  // that already inherit the dynasty surname.
  //
  // Defaulted rather than nullable so the column backfills itself and no
  // reader has to handle an absent value.
  gender Gender @default(NEUTRAL)

  // Denormalized mirror of formatCharacterName(...) above, same posture as
  // zoneId below. It exists because ~60 readers want a single string —
  // orderBy, `select: { name: true }`, the /gm/audit `contains` search, the
  // proxy webhook username and the dawnWipe map key — and Prisma cannot
  // concatenate columns in orderBy or contains, so dropping it would force
  // search and sort into OR-over-three-columns for correctness nobody sees.
  //
  // Exactly three writers keep it in sync, and every one of them goes
  // through formatCharacterName:
  //   web/app/(app)/character/createActions.js      (creation)
  //   web/lib/characterWrite.js                     (GM raw edit, dev panel)
  //   web/lib/dynasty.js                            (the Baron renames his house)
  // A fourth writer must do the same; `npm run db:backfill-name-parts` is the
  // drift check that catches one that doesn't.
  //
  // There is deliberately NO player-facing writer. A name is set once, in the
  // creation wizard, and is immutable afterwards —
  // web/app/(app)/character/actions.js used to be the fourth writer and now
  // ignores the name keys entirely. The only sanctioned change is the Mulligan
  // Potion (docs/tags.yaml), which a GM honours through the dev panel, i.e.
  // through characterWrite.js — the one path that also plans the Discord
  // fan-out (role title, role colour, nickname, dynasty propagation).
  name String

  // Display-only snapshot of the role's name at creation. `roleId` is the
  // authoritative link; roleTitle survives so a GM can hand-write something
  // off-catalog and so history reads correctly if a Role row is later pruned.
  roleTitle String?
  roleId    String?
  role      Role?   @relation(fields: [roleId], references: [id])

  factionId String?
  faction   Faction? @relation(fields: [factionId], references: [id])

  // Applications this character has open, in either direction.
  factionApplications FactionApplication[]

  // AUTHORITATIVE "where is this character" since Bascinet 2. Drives the
  // "Location: {Name}" Discord role (swapped by
  // db/lib/locationMove.js#applyLocationMoveSideEffects) and therefore the
  // one channel they can see. Null only for a character not yet placed.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // DENORMALIZED from location.zoneId — every writer of locationId writes
  // both, and db/lib/channelDoctor.js flags a mismatch. Kept because dozens
  // of readers group by zone (the seat tables, factions, #summary, the
  // narrowcast rules). Always a presence zone (SURFACE or CAVE_LEVEL, never
  // the CAVE_GROUP row); rows stamped onto Action/Note/
  // StagedMessage carry the SEAT zone instead (db/lib/seatZone.js).
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id])

  // When this character last walked between Locations under their own power
  // — the GameConfig.locationMoveCooldownSeconds clock. Set only by
  // db/lib/locationTravel.js#performLocationMove; a GM teleport or creation
  // leaves it alone so the character can step at once.
  lastLocationMoveAt DateTime?

  // The conceal toggle (/conceal, or the switch on /character). While on,
  // every message proxies under the concealedAlias with the unknown avatar,
  // and Who's here? lists the alias instead of the name.
  concealed Boolean @default(false)

  // Personal Discord role titled after this character's BARE name (first +
  // last, via formatBareName) and seeded to a muted color by
  // db/lib/roleColor.js#hashNameToColor from that same bare string, re-synced
  // whenever it changes (web/lib/discordGuild.js#ensureCharacterRole). Bare,
  // not the displayed name: the role is an @-mentionable name token rather
  // than an RP surface, and seeding off the bare name means granting or
  // changing a title never renames or recolours anyone.
  // It is assigned to NOBODY and grants nothing — holding it would list the
  // player's account under the character's name. Channel access is a
  // per-member overwrite instead (db/lib/locationAccess.js).
  discordRoleId String? @unique

  isLeader    Boolean         @default(false)
  isTreasurer Boolean         @default(false)
  status      CharacterStatus @default(ALIVE)
  resources   Int             @default(0)

  // When this body went into the ground, set by a BURY_CHARACTER request.
  // Nullable, so the column is both the flag and the record of when. A buried
  // corpse is out of the world: it cannot be looted, dragged or bound, and it
  // stops appearing in the zone's target menus. Cleared on revive, so a
  // GM-revived character is never a live person marked buried.
  buriedAt DateTime?

  // The in-game DAY a FAST_TRAVEL was last claimed on — despite the name,
  // NOT a turn id. A day is TWO turns (Dawn/Dusk), so this stores
  // The load at the last db/lib/carry.js settle — the watermark that tells an
  // ACQUISITION from a capacity SHRINK, which is the whole of what decides
  // whether anything is set down (docs/systemdocs/CARRY.md §5).
  //
  // Only a load that GREW past the ceiling sheds. Unequipping a cart at an inn
  // door, handing one over, or a GM lowering the base cap all leave the load
  // exactly where it was, so they make a character Overburdened and take
  // nothing off them. Without this the settle cannot tell the two apart, and
  // walking into an inn empties your cart onto its floor.
  //
  // The LOAD is stored, never the derived cap, for the same reason the old
  // multiplier watermark stored the multiplier: a cap is a thing the GM moves,
  // and moving it must not read as "you just picked something up".
  carryWeightSeen    Float @default(0)
  carryResourcesSeen Int   @default(0)

  // The free zone crossings this character has already spent, and the turn
  // they were spent in (docs/systemdocs/CARRY.md §2). Everyone gets
  // GameConfig.freeZoneMovesPerTurn a turn; an EQUIPPED mount adds one; being
  // Overburdened takes them all away. Past the allowance a crossing spends the
  // Move instead, exactly as it always did.
  //
  // Keyed on the TURN, not the day — a mount now carries you in both halves of
  // one day, which is the whole point of the rework. Claimed by a conditional
  // updateMany whose WHERE is the check, the same structural shape the hunger
  // decrement uses: counting a character's Actions afterwards would let two
  // tabs both pass and put the rider two zones away. A differing turn id
  // resets the counter in the same statement, so nothing has to sweep it.
  // Not a foreign key on purpose — it is a claim token, and deleting a turn
  // must never cascade into a character row.
  zoneMovesTurnId String?
  zoneMovesUsed   Int     @default(0)

  // The in-game DAY this character's bird last flew — the same claim token as
  // fastTravelTurnId above, for the same reason and with the same trap. A day
  // is TWO turns, so this stores String(describeTurn(openTurn).day) and NOT a
  // turn id; keying it on the turn would hand out two letters a day instead of
  // the one the feature promises. Written by a conditional updateMany whose
  // WHERE is the check, so two tabs racing cannot both send. Not a foreign key
  // — it is a claim token, and deleting a turn must never cascade into a
  // character row. See docs/systemdocs/BIRD.md.
  birdTurnId String?

  // Consecutive turns' worth of hunger this character is carrying — written
  // only by db/lib/hungerPass.js. Each hungry turn increments it; a fed turn
  // (paid or Ate Meal) only sheds ONE tick, not the whole streak, so it takes
  // as many fed turns to climb back down as it took starved turns to climb
  // up. Hungerless resets it to 0 outright (immunity, not eating). It scales
  // the Gambit penalty (db/lib/gambitModifier.js). At 6 the pass grants
  // `dying` and leaves it there — a GM confirms the death by hand, same as
  // every other terminal chain (tagExpiryPass.js).
  hungerStreak Int @default(0)

  // Consecutive turn closes without a Fine/Lavish Meal — written only by
  // db/lib/hungerPass.js, and only ever moved for characters holding
  // `nobility` (everyone else stays at 0, so granting the tag mid-game
  // starts the count fresh). At DISAPPOINTMENT_THRESHOLD the pass grants
  // `disappointed` (flat −1 Gambit, gambitModifier.js); a fed turn resets
  // the count to 0 outright — unlike hungerStreak there is no slow climb
  // back down, one proper meal settles the matter. Eating also clears the
  // tag on the spot (web/app/(app)/character/requestActions.js); the pass's
  // reset is the backstop for GM-granted meals.
  missedMealStreak Int @default(0)

  // Turn number this character last acted or spoke in character — a
  // player-filed Action (never an auto one; defaultMovePass.js does not
  // touch this) or a proxied/`/speak` message. Same shape as
  // PlayerThread.lastActivityTurn and for the same reason: "no activity for
  // N turns" cannot be read reliably out of best-effort, player-erasable
  // records (ArchiveEntry writes swallow failure, and a ❌ reaction deletes
  // the row). Written debounced to one update per character per turn by
  // db/lib/characterActivity.js#touchCharacterActivity. Read by
  // db/lib/catatonicPass.js. Null only before this column's own backfill
  // migration and for a character created after — the pass treats null as
  // "as of right now", never as stale. (The debouncing writer's `not:` guard
  // used to exclude NULL rows — Prisma's `not: N` is SQL `<>`, NULL-false —
  // so this column never got stamped at all for the game's first six turns;
  // characterActivity.js carries the fix and the note.)
  lastActivityTurn Int?

  // Turn number this character was flagged `catatonic-afk` — the death
  // countdown's clock, read only by db/lib/catatonicDeathPass.js. Written by
  // db/lib/catatonicPass.js when it grants the tag and by
  // db/lib/playerDeparture.js when the player leaves the guild; nulled when
  // the pass clears the tag and when the death pass kills them. Kept separate
  // from lastActivityTurn so a GM moving GameConfig.catatonicTurns mid-game
  // doesn't retroactively move everybody's execution date. Null while holding
  // the tag means "no countdown" (a GM hand-grant), which fails safe.
  catatonicSinceTurn Int?

  // Set when guildMemberRemove (or the startup reconcile in
  // bot/src/lib/leaveReconcile.js) sees this character's player is gone;
  // cleared by guildMemberAdd on rejoin. Three readers: the catatonic pass
  // never clears the tag off a character carrying this (a departed player's
  // activity clock can't move, and a NULL clock reads as "active now"); the
  // death pass's reason text; and the reconcile's idempotency guard, which is
  // what stops a restart loop re-alerting #leave.
  leftGuildAt DateTime?

  // Unspent point-buy points. Seeded at creation with whatever the player
  // didn't spend in the wizard (budget minus purchases) and drawn down by
  // the mid-game store.
  tagPoints      Int     @default(0)
  avatarData     Bytes?
  avatarMimeType String?

  // The portrait maker's selection as JSON — part indices and palette indices,
  // never pixels. avatarData holds the render; this holds what it was built
  // from, so reopening the modal resumes where the player left off instead of
  // starting from the default face. Null for an uploaded picture or a letter
  // plaque. Validated on every read by
  // web/lib/portrait/catalog.js#parseSelection, so a stale index left behind
  // by a catalog change degrades to the default part rather than throwing.
  portrait      String?
  appearance    String?
  turnPingOptIn Boolean @default(true)

  // 18-90, or null until the player first sets one. Free to edit while null;
  // the moment a number lands it is fixed — the /character input renders
  // disabled and updateCharacterProfile refuses to overwrite a non-null age,
  // the same shape as the GM-granted `title` above. A GM can still change it
  // from /gm/dev/characters/[characterId]. Read by
  // db/lib/concealedIdentity.js for the Young/Old half of a concealed alias.
  age Int?

  // Which secretly GM-assigned antagonist seats this player is open to being
  // handed (Succubus, the Judge...). Consent data only: nothing in
  // the game reads it, grants from it, or gates on it — it exists so a GM
  // picking who receives one can tell who is willing.
  //
  // Set once, on the Antagonists step of the creation wizard, and never
  // player-editable afterwards; updateCharacterProfile not reading the key is
  // the lock, same posture as the GM-granted `title` above.
  //
  // A String[] of slugs validated against db/lib/threats.js rather than a
  // relation: eleven fixed values that can never differ per environment, so a
  // table would only add a join and a way to drift.
  antagonistOptIns String[] @default([])

  tags                    CharacterTag[]
  actions                 Action[]
  auditLogTargets         AuditLog[]
  notes                   Note[]
  requests                Request[]
  desires                 Desire[]
  stagedMessageRecipients StagedMessageRecipient[]
  stagedEffects           StagedEffect[]
  cavingRolls             CavingRoll[]
  gmNotes                 GmCharacterNote[]
  craftProjects           CraftProject[]
  roomGuestOf             RoomGuest[]
  noticePosts             NoticePost[]             @relation("NoticePostAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The one Tag row this character's death wrote. See Tag.corpseOfCharacterId.
  corpseTag Tag? @relation("CharacterCorpseTag")

  @@index([discordUserId])
  @@index([status])
  @@index([status, lastActivityTurn])
}

// Fresh or rotten. A player's corpse is written FRESH and turns ROTTEN three
// turns later (Tag.expiresInto, progressed by db/lib/tagExpiryPass.js on a
// sheet and db/lib/roomTagExpiryPass.js on a floor). The three monster
// corpses in docs/tags.yaml are always FRESH and never rot — a Nekker left
// lying around stays butcherable, and only a person stinks.
enum CorpseKind {
  FRESH
  ROTTEN
}

// What a sheet of paper currently IS. Null on every ordinary tag, and null on
// the blank `paper` catalog tag too — a blank sheet is stackable stock, not a
// document. A row only gets one of these once somebody has written on it.
//
// SEALED is the same row renamed in place, the way a corpse rots
// (db/lib/corpseRotPass.js): a letter somebody is carrying seals in their
// hands with no second row to reconcile. BROKEN_SEAL is a separate row minted
// when the seal is broken — the spent envelope, which is evidence.
enum PaperKind {
  PAPER
  SEALED
  BROKEN_SEAL
}

// Master-sourced from docs/tags.yaml (db/lib/syncTags.js#syncTagsFromYaml,
// npm run db:sync-tags) — same non-destructive upsert-by-slug contract as
// Location/docs/locations.yaml: removing a tag from the YAML never deletes
// its row here.
model Tag {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  category    String
  pointCost   Int     @default(0)

  // Authored by a GM at /gm/dev/tags rather than declared in docs/tags.yaml.
  // syncTags.js is keyed by slug and upsert-only, so it never sees these
  // rows; db:prune-tags, which IS destructive, skips them explicitly. Their
  // slugs are server-generated with a "custom-" prefix so a GM naming one
  // after an existing YAML tag can't collide with it and get upserted over.
  custom Boolean @default(false)

  // --- Corpses (docs/systemdocs/CORPSES.md) ------------------------------
  //
  // A THIRD kind of tag, beside the YAML catalog and a GM's homebrew: one the
  // SYSTEM authors. db/lib/characterDeath.js writes ONE row per death ("Ada's
  // Corpse"), and the three monster corpses come from docs/tags.yaml instead.
  // Both kinds set corpseKind, so "is this a corpse?" is one field however the
  // row got here — which is what the Butcher button and Miasma's ingredient
  // check both ask.
  //
  // Rotting RENAMES that one row rather than chaining into a second tag
  // (db/lib/corpseRotPass.js). expiresInto could not do it: it names catalog
  // SLUGS, and "Ada's Rotten Corpse" is per-character and never in the YAML.
  // Renaming also means a corpse someone is carrying rots in their hands with
  // no second row to reconcile — the holding is the same row it always was.
  //
  // Reusing `custom` for this was the obvious shortcut and it does not work:
  // TAGS.md §5d deliberately refuses to let a GM hand-author a decay chain,
  // and `custom` says "a GM typed this", which is exactly what a corpse is not.
  corpseKind CorpseKind?

  // The body this tag IS — the whole point of the design. A corpse is a HANDLE
  // to a dead sheet, not a container: the goods stay on the Character row and
  // LOOT_CHARACTER is untouched, but db/lib/corpseFollow.js joins through this
  // to walk the dead sheet after its corpse, so looting works wherever the
  // body was carried to. Null on the three monster corpses.
  //
  // Unique because there is exactly one corpse per death, which makes the
  // death path an upsert and the revive path a delete-by-character.
  //
  // Cascade, and it is load-bearing: it is the ONLY thing that stops these
  // rows outliving a Restart Game. wipeGameData deliberately never touches the
  // catalog, and its existing order already clears CharacterTag and RoomTag
  // before character.deleteMany() — so the cascade lands clean with no edit to
  // the wipe at all. A GM deleting one character gets the same for free.
  corpseOfCharacterId String?    @unique
  corpseOf            Character? @relation("CharacterCorpseTag", fields: [corpseOfCharacterId], references: [id], onDelete: Cascade)

  // Whether other players who 🔍-react to this character's proxied messages
  // see this tag, alongside Character.appearance (see
  // bot/src/events/messageReactionAdd.js). Three states, authored in
  // docs/tags.yaml as `visible: true | false | worn` — WORN means the tag is
  // shown only while CharacterTag.equipped, so a stowed dagger stays hidden
  // and a drawn one doesn't. Defaults closed so identity/status tags (Mortus,
  // Drained, ...) stay hidden unless explicitly opened up.
  //
  // This replaced a `visibleOnInspect Boolean`, and the RENAME was the point:
  // a tri-state kept under the old name would have been truthy for WORN, so
  // every surviving `if (tag.visibleOnInspect)` would have leaked every stowed
  // weapon on the day of the migration. Under a new name a missed read site
  // gets `undefined` instead, and the tag stays hidden — a vision gate should
  // fail closed. Read it through seenByBystander() (db/lib/medicalVision.js)
  // rather than comparing the enum by hand.
  inspectVisibility TagVisibility @default(HIDDEN)

  // Mutually exclusive with every other tag carrying this flag IN THE SAME
  // GROUP: a character may hold at most one of them per group. Set on the
  // Beliefs (Post-Christian, Atheist, Existentialist, Fundamentalist, the
  // four Old Ways), which are meant to be a single answer rather than a
  // collection. The one exception is
  // a pair joined by requiredTag — Fundamentalist requires Post-Christian and
  // so stacks on it. Enforced by exclusiveConflict()
  // (web/lib/characterCreation.js), called from PointBuy, createCharacter,
  // the store's buyTags and the Add Tag request. A GM grant ignores it,
  // deliberately, like every other gate.
  exclusive Boolean @default(false)

  // Optional grouping within a category (e.g. Status -> Health/Food/Buffs/
  // Debuffs), purely for display coloring (see TagGroup.color / TagChip.js)
  // — groupless tags render with no color accent.
  groupId String?
  group   TagGroup? @relation(fields: [groupId], references: [id])

  // For sequential/tiered skill tags (Cooking (Basic) -> Cooking (Skilled)):
  // the tier this one upgrades from. Buying/granting a tag with a parent
  // replaces the parent on the character rather than stacking with it.
  parentTagId String?
  parentTag   Tag?    @relation("TagUpgrade", fields: [parentTagId], references: [id])
  upgrades    Tag[]   @relation("TagUpgrade")

  // Non-replacing prerequisite, distinct from the parentTag chain above: a
  // character must already hold requiredTag before this one is meant to be
  // obtainable, but acquiring this one does NOT remove/replace requiredTag
  // (e.g. Fighting (Archer) requires Fighting (Basic) but coexists with
  // Fighting (Skilled)). Also the mechanism behind whole-group gating — see
  // TagGroup.requiredTag — for hiding an entire group behind a membership
  // tag. Both are enforced by requirementSatisfied()
  // (web/lib/characterCreation.js): the point-buy menu, the Add Tag picker,
  // and the createCharacter/addTagRequest server actions that re-check them.
  // A GM grant still ignores both, deliberately.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagPrerequisite", fields: [requiredTagId], references: [id])
  unlocks       Tag[]   @relation("TagPrerequisite")

  // Live: whether this tag can change hands at all. It gates BOTH directions —
  // handing it to someone in your zone (TRANSFER_TAG) and lifting it off a
  // corpse or a helpless body (LOOT_CHARACTER) — via
  // web/lib/tagRequests.js#isTradeable, which every one of those menus filters
  // on and both server actions re-check. This used to be a category test
  // (Items + Assets), which was wrong in both directions: it let a corpse be
  // stripped of its House and its Drone, and it ignored the graft in somebody's
  // neck that already said false right here. One flag on purpose; splitting
  // give from take would be a second field. See docs/systemdocs/TAGS.md §5.
  //
  // db/lib/syncTags.js THROWS if an items/assets tag omits it, so the `false`
  // default below can never silently make new gear unmovable.
  tradeable Boolean @default(false)

  // What one UNIT of this tag weighs, in pounds — the load half of
  // docs/systemdocs/CARRY.md §1, against GameConfig.carryWeightLbs. Null means
  // weightless: every skill, status, injury and belief, plus the Assets, which
  // carry themselves (a horse) or do not move at all (a house).
  //
  // Price it off the band table in CARRY.md §1a, never by feel — the same
  // discipline the point scale gets in TAGS.md §4a.
  weightLbs Float?

  // What this tag adds to BOTH carry caps, as a signed distance from ×1: Cart
  // +4, Giant +0.75, Frail −0.1. Counted only while the row is EQUIPPED
  // (CharacterTag.equipped) — a cart you are not pulling hauls nothing. A body
  // trait like Pack Mule or Frail is not equippable at all, so it always
  // counts. ADDITIVE across held rows, floored at ×0.25; see db/lib/carry.js.
  carryBonus Float?

  // Whether this tag is a thing a character can wear or carry readied, and so
  // occupies one of their GameConfig.equipSlots. Equipped state lives on
  // CharacterTag.equipped; equipping is instant and writes no Request.
  equippable Boolean @default(false)

  // Marks gear that hides who the wearer is — a mask, hood or closed helm.
  // This is the gate on /conceal: without one of these EQUIPPED, a character
  // cannot go unnamed at all. Only meaningful together with equippable, and
  // db/lib/syncTags.js throws if it is set without it, since a mask nobody can
  // equip could never conceal anything. See docs/systemdocs/TAGS.md.
  concealsIdentity Boolean @default(false)

  // Concealment with no say in it — a sack tied over the head, a plague mask
  // whose whole point is that the wearer is nobody. While one of these is
  // equipped the character is concealed whatever Character.concealed says, and
  // both /conceal toggles refuse to turn it off. Requires concealsIdentity;
  // syncTags.js throws otherwise, since forcing a concealment the catalog does
  // not grant is a contradiction rather than a stricter setting.
  forcesConceal Boolean @default(false)

  // Which plated 256px avatar a concealed wearer shows, as a basename under
  // web/public/assets/helms (built by web/scripts/generate-helms.js). Required
  // alongside concealsIdentity — a hood nobody can see is not concealment,
  // it is a missing image — and syncTags.js checks the file is really there,
  // because a typo here would otherwise surface as a broken avatar in Discord
  // rather than as a failed sync.
  concealSprite String?

  // Where this sits on the body, and how deep. Two equipped tags may not share
  // a slot, nor a layer within HEAD/BODY: layer 1 is against the skin and 4 is
  // outermost, so a mail coif (1) goes under a knight's helm (3) but two helms
  // do not go together. The OUTERMOST equipped concealing piece is the one
  // whose concealSprite the room sees. Enforced in both places that flip
  // CharacterTag.equipped — equipActions.js and db/lib/tagOps.js.
  equipSlot  EquipSlot?
  equipLayer Int?

  // The opposite of hiding: a tag that FIXES how the character presents. While
  // any held tag carries this, the character posts under this name with the
  // letter plaque for its initial (never their own face), Who's here? and 🔍
  // name them this way, and both /conceal toggles refuse. Apex Form sets it to
  // "Beast". Nothing on the Character row changes — every surface resolves it
  // at read time through db/lib/presentedIdentity.js (forced > concealed >
  // own name), the same posture as the letter plaque itself. The @-mention
  // role and the nickname deliberately keep the real bare name. Authored in
  // docs/tags.yaml as `forcesName:`; syncTags.js caps it at
  // NAME_LIMITS.firstName and refuses it beside concealsIdentity.
  forcedName String?

  // Whether a character can hold more than one of this tag at a time —
  // meals, ammunition, anything a crafting Move produces in a batch. A
  // stack is ONE CharacterTag row carrying a count (CharacterTag.quantity),
  // never N rows: @@unique([characterId, tagId]) stays, so every presence
  // check in the codebase (narrowcastAccess, gambitModifier, labor)
  // keeps reading "holds it or doesn't" unchanged. Safe to combine with
  // defaultDurationTurns: the expiry sweep sheds one unit per expiry and
  // rerolls the remaining stack's timer, rather than deleting the row.
  stackable Boolean @default(false)

  // Whether a player could ever buy this via point-buy, and (only meaningful
  // when true) whether it stays buyable once the game is underway vs. being
  // a starting-package-only pick. No purchase flow exists yet — catalog data
  // only, for a future store to read.
  purchasable           Boolean @default(false)
  purchasableAfterStart Boolean @default(true)

  // Role slugs (docs/roles.yaml) that may NOT buy this tag, authored in
  // docs/tags.yaml as `excludedRoles:`. Devoted Follower is the first user:
  // a Migrant or a Bum has no faction to be devoted to. Plain slugs rather
  // than a Role relation on purpose — db:sync-roles rewrites Role rows and a
  // relation would need re-linking every time, while the slug is the stable
  // key the rest of the codebase already matches roles on (CURSED_ROLE_SLUGS).
  // Empty is the overwhelmingly common case: a tag open to every seat.
  //
  // Enforced by roleExcluded() (web/lib/characterCreation.js) — the point-buy
  // menu drops the row, and createCharacter/the store's buyTags re-check it.
  // A GM grant ignores it, like every other gate here.
  excludedRoleSlugs String[] @default([])

  // The other direction: role slugs that are the ONLY seats which may buy this
  // tag, authored in docs/tags.yaml as `onlyRoles:`. Vow of Silence is the
  // first user — a Minstrel who will not sing is a character, anybody else
  // choosing it is just a free tag. Empty means "open to every seat", which is
  // the overwhelmingly common case, so the default is the permissive one.
  //
  // A whitelist rather than listing the other 38 seats in excludedRoleSlugs:
  // that spelling would silently open the tag every time a new role is added
  // to docs/roles.yaml. Same plain-slug reasoning as above.
  //
  // Read by the same roleExcluded() (web/lib/characterCreation.js), so the
  // menu, createCharacter and the store's buyTags all inherit it at once. A GM
  // grant ignores it, like every other gate here.
  onlyRoleSlugs String[] @default([])

  // The other side of purchasable: whether the Merchant's Depot will buy
  // this off him, and for how many ⬢. Live as of the Merchant Update — read
  // by the Sell counter on /depot (DEPOT_SELL). syncTags.js requires the two
  // fields to travel together: sellable without a positive sellablePrice is
  // an error, and so is a price without sellable: true.
  sellable      Boolean @default(false)
  sellablePrice Int?

  // The buy side of the same counter: what the Depot CHARGES the Merchant for
  // one of these, read by DEPOT_BUY. Null means the station does not stock it
  // at all, which is the case for everything Ravenheart makes itself — the
  // Depot only imports. A ware is Depot-stocked purely by having this, so it
  // travels with nothing else; syncTags.js only checks it is positive, and
  // warns (without throwing) if it is at or under the tag's own sellablePrice,
  // since buying and selling the same tag in a loop would print ⬢.
  // See docs/systemdocs/DEPOT.md §3.
  depotPrice Int?

  // Whether a shipment of this arrives SEALED. A sealed crate prints no
  // manifest and only a Depot Keycard opens it, so this is how a dangerous or
  // valuable ware stays unreadable on the landing pad until the right person
  // gets to it. Authored in docs/tags.yaml rather than guessed from the
  // category, because "dangerous" is a judgement about the fiction and the
  // catalog is where those live. One sealed line item seals the whole crate it
  // lands in. See docs/systemdocs/DEPOT.md §5.
  sealedShipping Boolean @default(false)

  // What falls out of a crate when it is opened, as
  // `[{ tagId, name, quantity }]`. Set only on the runtime crate tags
  // db/lib/depotCrates.js mints, and null on every catalog row.
  //
  // It lives on the crate rather than on the shipment so a crate is entirely
  // self-describing: it can be carried out of the landing pad, traded away and
  // opened in a cellar three zones over without anything needing to look up
  // where it came from. See docs/systemdocs/DEPOT.md §5.
  crateContents Json?

  // --- Paperwork (docs/systemdocs/PAPERWORK.md) --------------------------
  //
  // A written sheet is a Tag row minted at runtime, the same shape as a crate
  // or a corpse. What makes it different from every other tag in the catalog
  // is that its text is PRIVATE: whether you can read it depends on your eyes
  // and your letters, so the sentence a reader sees cannot be baked into
  // `description` the way every other tag's is.
  //
  // That matters more than it sounds. web/lib/referenceData.js#getVisibleTags
  // ships the WHOLE catalog, descriptions included, to every signed-in
  // browser. A letter's text in `description` would publish every letter in
  // the game. So it lives here instead, TAG_CHIP_FIELDS never selects it, and
  // the description is composed per request, per viewer, by
  // db/lib/paper.js#paperDescription.
  paperKind PaperKind?

  // The sheet's contents. APPEND-ONLY — the Write dialog shows what is already
  // there read-only and adds beneath it. You can always write more; you can
  // never unwrite.
  paperText String?

  // Who wrote on it first, by presented name, for the generated title ("A Note
  // (hand of Ada)"). Kept as a snapshot rather than a relation: the row has to
  // outlive its author, and a dead writer's letter still names them.
  paperAuthor String?

  // A wax stamp's distinguishing line — "Three cups, stacked." Authored in
  // docs/tags.yaml as `sealMark:`, which is also what makes the stamp a stamp:
  // db/lib/syncTags.js composes the whole description around it, so the
  // boilerplate is written once and {sealMark} has one clean source.
  //
  // Copied onto a letter this stamp seals, and onto the envelope left behind
  // when that seal is broken. The Merchant's is the one exception — null in
  // the YAML, written at character creation beside setMerchantFace, because it
  // bears his actual initials (web/app/(app)/character/createActions.js).
  sealMark String?

  // Minted at runtime rather than authored, and therefore GAME state rather
  // than catalog: crates, headstones, written paper, sealed letters. A Restart
  // Game deletes exactly these rows and leaves the docs/tags.yaml catalog and
  // a GM's homebrew from /gm/dev/tags alone.
  //
  // This closes a real leak. wipeGameData never touched the Tag catalog, and
  // db:prune-tags skips every `custom` row on purpose — so crates and
  // headstones were permanent orphan rows accumulating across every game. Only
  // corpses escaped, and only through corpseOfCharacterId's cascade. `custom`
  // could not be reused for this: a GM's homebrew is custom and must SURVIVE a
  // restart, which is the opposite of what this asks.
  ephemeral Boolean @default(false)

  // Catalog-level default duration in turns, for tags that auto-expire once
  // granted (mirrors CharacterTag.expiresTurn's "absolute turn number, swept
  // by resolveNeeds()" convention). E.g. Drained sets this to 3, so donating
  // blood expires 3 turns after it's granted.
  defaultDurationTurns Int?

  // Whether a player can use this tag up — eat the meal, unpack the crate.
  // Live, like removable/craftable above: it drives the Consume menu on
  // /character (web/lib/tagRequests.js) and is re-checked server-side by
  // consumeTagRequest, since the client's filtered menu is only advisory.
  // See docs/systemdocs/REQUESTS.md. Consuming always takes exactly ONE
  // unit, so a stack of meals feeds the character several times.
  consumable Boolean @default(false)

  // Tag slugs this tag turns INTO when it is consumed: a meal becoming Ate
  // Meal, Starting Wares unpacking into a revolver and jewelry. Slugs rather
  // than a relation specifically so a slug may REPEAT — listing one twice
  // grants two of it (for a stackable tag; a non-stackable repeat collapses
  // to one). A granted tag with its own defaultDurationTurns starts that
  // clock at the moment it's granted, so chains work (meal -> Ate Meal that
  // the sweep then clears). Empty means consuming just uses the tag up.
  consumesInto String[]

  // The Resources half of consuming, added for the Caves Update's Purse and
  // Supply Kit — a Purse has no tag half at all (consumesInto: []), while a
  // Supply Kit combines both. Null means consuming grants no Resources.
  // Applied by the same consumeTagRequest that reads consumesInto, through
  // the ordinary creditResources primitive (web/lib/requestEffects.js), and
  // snapshotted into Request.effect so CONSUME_TAG's undo can debit it back
  // without re-deriving from live state. See docs/systemdocs/CAVING.md.
  consumesIntoResources Int?

  // Parallel array to consumesInto, same length and order — added for the
  // Caves Update's Skinned Cave Rat (a 50/50 pick between Ate Meal and
  // Vomiting). Each entry is either null (that position grants exactly the
  // slug consumesInto holds there) or a list of two-or-more alternative
  // slugs to pick between with even odds; when it is a list, the
  // corresponding consumesInto[i] holds the first alternative only as a
  // display fallback — web/lib/consumeGrants.js reads this field first and
  // rolls the real pick, the same { oneOf: [...] } shape expiresInto already
  // uses for db/lib/tagExpiryPass.js. Null (the column, not an entry) is by
  // far the common case — almost nothing needs a random consume outcome.
  consumesIntoOneOf Json?

  // Per-target conditions on the list above, as { "<target slug>": ["<blocking
  // slug>", ...] } — the target is granted only if the character holds NONE of
  // its blocking tags. Null when a tag's grants are all unconditional, which is
  // almost all of them. consumesInto still carries every target slug in order,
  // so validation and the "Becomes:" previews keep reading one field.
  //
  // Nothing in the catalog sets this today — Fine Meal was the only user, via
  // { "happy": ["nobility"] }, and it went with the Mood system. The field and
  // its resolver stay because the mechanism is general: it is resolved by
  // web/lib/consumeGrants.js, which both the server action and the client
  // previews call so a preview can't promise something the grant won't
  // deliver.
  consumesIntoUnless Json?

  // Per-target expiry overrides on the same list, as { "<target slug>": N } —
  // the granted tag's clock is set to N turns instead of its own
  // defaultDurationTurns. Null when nothing overrides, which is almost every
  // tag.
  //
  // This exists because one status can mean different things depending on
  // what produced it: raw Cave Fungus leaves you High for 2 turns, while
  // Bliss — the refined version — leaves you High for 3. Encoding that on the
  // High tag itself is impossible (it has one defaultDurationTurns), and
  // splitting it into high-2/high-3 would push an implementation detail into
  // the player-facing catalog and multiply with every future drink.
  //
  // Read by web/lib/consumeGrants.js alongside consumesIntoUnless and applied
  // by grantTagSlugs, which prefers the override and falls back to the target
  // tag's own defaultDurationTurns. An override on a target that has no
  // duration of its own is legal and simply gives it one for this grant — but
  // don't point one at Ate Meal, which is deliberately never swept because the
  // Hunger pass consumes it explicitly.
  consumesIntoDurations Json?

  // What this tag turns INTO when its timer runs out, rather than simply
  // being swept away: the untreated-condition chain (Infected -> Festering ->
  // Feverish + Necrosis -> ...). Distinct from consumesInto above, which is
  // player-driven and chosen; this one fires on the clock whether or not
  // anybody wanted it to, which is the entire point of a wound that gets
  // worse while you ignore it.
  //
  // A JSON array whose entries are either a bare slug string, or
  // { "oneOf": ["<slug>", "<slug>"] } for an even random pick between them
  // (Necrosis costing you a leg or an arm). Json rather than String[] only
  // because of that second form. Null means the tag just expires.
  //
  // Applied by db/lib/tagExpiryPass.js, which runs inside resolveNeeds()
  // immediately BEFORE the sweep that deletes the expired row — it has to
  // read the row before the delete removes it. Validated up front by
  // db/lib/syncTags.js: every slug must exist, the tag must carry a
  // defaultDurationTurns (or nothing would ever fire it), and a tag may not
  // list itself (the grant would be undone by the sweep one statement later).
  expiresInto Json?

  // What this tag turns INTO when it leaves the sheet through a PLAYER-DRIVEN
  // removal — the Remove Tag request and the Heal request, both of which grant
  // it inside their own transaction. This is the treated-wound aftermath: a
  // Broken Bone cured is a Splinted limb for four turns, so medicine ends the
  // danger without erasing the injury. Distinct from expiresInto (the clock)
  // and consumesInto (using a tag up); a GM removal (/heal, the Dev Panel
  // revoke) stays godmode and never fires it.
  //
  // Same Json shape as expiresInto — entries normalized to { oneOf: [...] } —
  // and validated by the same db/lib/tagShapes.js pair on both authoring
  // doors. No durationTurns requirement: the removal fires it, not a clock.
  // The granted tag's own defaultDurationTurns (or permanence) decides how
  // long the aftermath lingers. A successor the character already holds is
  // left alone, matching the expiry pass.
  removesInto Json?

  // The four capability flags. Each one fills exactly one player menu and is
  // re-checked server-side by the matching request; none is derived from the
  // category (docs/systemdocs/TAGS.md §5). All four are explicit in
  // docs/tags.yaml — the sync never infers one.
  //
  // removable: the Destroy menu (web/lib/tagRequests.js#destroyableTags,
  // REMOVE_TAG). Destroying refunds nothing — so a removable,
  // purchasableAfterStart tag (the Beliefs group) costs its price again on
  // every re-purchase.
  removable Boolean @default(false)

  // craftable: the Craft menu (docs/systemdocs/CRAFTING.md). A recipe also
  // needs its requirementSkills held; turns and ⬢ come from the requirement
  // block below.
  craftable Boolean @default(false)

  // healable: the Heal menu (HEAL_CHARACTER). A cure exists — its cost is the
  // requirement block below, and the medic must hold requirementSkills.
  healable Boolean @default(false)

  // teachable: Learn / Teach can move it between characters
  // (docs/systemdocs/LESSONS.md).
  teachable Boolean @default(false)

  // What it costs a character to gain or shed this tag through play (e.g.
  // curing Arthritis needs Medical (Skilled), some turns, and resources;
  // forging a sword tag costs turns, resources, Smithing, no Gambit). One
  // shared set of fields covers whichever direction is narratively relevant
  // for a given tag (crafting only cares about adding it; healing only cares
  // about removing it) rather than separate add/remove blocks.
  //
  // Enforced in both directions now. Heal (HEAL_CHARACTER) charges
  // requirementResources and needs requirementSkills held by the medic;
  // Craft (docs/systemdocs/CRAFTING.md) needs requirementSkills held by the
  // crafter, charges requirementResources up front, and spends
  // requirementTurns Moves (0 = Dead Simple, no Move). requirementGambit is
  // a cure-only flag: crafting is always a Routine.
  requirementTurns     Int?
  requirementResources Int?
  requirementGambit    Boolean @default(false)

  // How many UNITS of this recipe one character may make in a turn. Only
  // meaningful for a 0-turn recipe: anything costing a Move is already
  // rationed to one by Action's unique constraint. Null falls back to
  // DEAD_SIMPLE_PER_TURN (web/lib/requests.js), which is what every Dead
  // Simple rung used before this was a field. See SMITHING.md §2.
  requirementPerTurn Int?
  requirementSkills  Tag[] @relation("TagRequirementSkill")
  requiredForSkillOf Tag[] @relation("TagRequirementSkill")

  // The INGREDIENT half of a recipe, and the first of these ever enforced —
  // BREWING.md's "no code enforces a recipe, least of all the ingredient" is
  // no longer true of the two entries that carry this. Authored in
  // docs/tags.yaml as `requirement.items`, normalized and validated by
  // db/lib/tagShapes.js#normalizeRequirementItems.
  //
  // Json rather than a Tag[] relation, because an entry is EITHER a tag slug
  // ({ slug: "skinless-brain" }) OR a whole group ({ group: "items-corpse" }),
  // and Miasma needs the second: a corpse tag written at death is never in the
  // YAML, so no relation authored there could ever name one.
  //
  // HOLDING IT IS THE CHECK. Nothing here is consumed — you keep the corpse
  // you bottled the Miasma over.
  requirementItems Json?

  // What holding (or wearing) this tag adds to one kind of Laboring, from
  // docs/tags.yaml's `laborBonus:` block. Normalised by db/lib/tagShapes.js
  // and read by db/lib/laborAccess.js when it scores a labor candidate.
  //
  // Shape: { kind: "hunting"|"farming"|"fishing", amount: Int,
  //          equipped: Bool, requiresTag: String? }. A flat number of the
  //          hexagon, added AFTER the location coefficient has scaled the
  //          range, so a tool is worth the same everywhere.
  //
  // Json rather than three columns because most tags have no bonus at all,
  // and because `requiresTag` (the Plow needs a horse) has no column shape.
  laborBonus Json?

  // What holding this tag does to the Desire catalog, from docs/tags.yaml's
  // `desires:` block. Normalised + validated by db/lib/desireShapes.js
  // (shared by db:sync-tags and db:sync-desires, same posture as
  // db/lib/tagShapes.js). Null for the ~99% of tags that lock nothing.
  // An ARRAY of clauses, union semantics — each clause is exactly one of
  // {all:true} | {families:[...]} | {tiers:[...]}, plus an optional
  // exceptFamilies. Multi-clause is needed for Nobility. The GM's
  // custom-tag form at /gm/dev/tags does NOT get an editor for this — a GM
  // homebrew tag never locks catalog content.
  desireLocks Json?

  // Pairwise cross-group incompatibility. Tag.exclusive above is same-group
  // only (one Belief, one Addiction); this is the "this Addiction and that
  // Restriction cannot coexist" rule, which no existing mechanism could
  // express. Written in BOTH directions by db:sync-tags, so a caller only
  // ever has to check one side.
  conflictsWith Tag[] @relation("TagConflicts")
  conflictedBy  Tag[] @relation("TagConflicts")

  desireRequiredBy    DesireTemplate[] @relation("DesireRequiresAnyTag")
  desireForbiddenBy   DesireTemplate[] @relation("DesireForbidsTag")
  desireAllRequiredBy DesireTemplate[] @relation("DesireRequiresAllTag")

  characters    CharacterTag[]
  roomTags      RoomTag[]
  noticePost    NoticePost?
  gatedGroups   TagGroup[]     @relation("TagGroupGate")
  cavingRolls   CavingRoll[]
  offers        Offer[]
  craftProjects CraftProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Declared here as well as in 20260906010000_corpses/migration.sql, so the
  // schema and the migration history agree about it. They did not at first:
  // the index was raw SQL only, which made every `prisma migrate diff` propose
  // DROP INDEX "Tag_corpseKind_idx" as if it were drift somebody introduced.
  // The two trgm indexes still read that way and still have to be declined by
  // hand (see CLAUDE.md); this one no longer does.
  @@index([corpseKind])
  // Declared here as well as in the migration SQL, so `prisma migrate diff`
  // does not read it as drift. Same reasoning as the corpseKind index above.
  @@index([ephemeral])
}

// Optional grouping of tags within a single category, purely for display
// coloring (see TagChip.js) — e.g. the Status category's Health/Food/Buffs/
// Debuffs groups. Also master-sourced from docs/tags.yaml, same
// non-destructive upsert-by-slug contract as Tag.
model TagGroup {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // Must match one of the categories declared at the top of docs/tags.yaml —
  // a plain string, not a DB-enforced FK, same as Tag.category.
  category String

  // Freeform hex color (e.g. "#6fa8ab"), rendered directly by TagChip.js —
  // null means uncolored. Not theme-aware; docs/taggroups.yaml is the
  // source of truth for values in use.
  color String?

  // Whole-group gate: every tag in this group stays hidden until the
  // character holds requiredTag. This is the hidden-category mechanism —
  // the Demoness category holds exactly one gated group,
  // so until you hold the unlocking tag the category has no tab in any
  // picker and its tags are withheld from /api/tags outright. Live:
  // requirementSatisfied() in web/lib/characterCreation.js is the single
  // reader, called by PointBuy, the Add Tag picker, createCharacter and
  // addTagRequest; the API route filters on it directly.
  requiredTagId String?
  requiredTag   Tag?    @relation("TagGroupGate", fields: [requiredTagId], references: [id])

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharacterTag {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  source      TagSource
  acquiredAt  DateTime  @default(now())

  // Turn number this tag expires at, swept by resolveNeeds() in db/index.js
  // once the closing turn's number reaches it. Null means it never
  // auto-expires. An ordinary tag's row is deleted; a Tag.stackable one
  // instead loses a single unit and has this field pushed forward by the
  // tag's defaultDurationTurns, until the last unit takes the row with it.
  // Used for system-granted temporary status tags (Ate Meal, Tipsy) — see
  // EVENT below.
  expiresTurn Int?

  // Whether this held tag is currently equipped, capped across a character by
  // GameConfig.equipSlots and only ever true for a Tag.equippable one. A
  // stackable tag takes ONE slot however many units are held — the flag is a
  // property of holding the tag, not of each unit, which is also why this is
  // a column here rather than a separate join table.
  equipped Boolean @default(false)

  // How many of this tag the character holds. Always 1 for an ordinary tag;
  // only Tag.stackable ones ever go above it, and nothing may drive it
  // below 1 — the row is deleted instead. Point-buy never sets this: the
  // wizard is a toggle-set, so a bought tag lands on the default.
  quantity Int @default(1)

  @@unique([characterId, tagId])
}

// A playable seat, master-sourced from docs/roles.yaml's
// zones[].factions[].roles[] (db/lib/syncRoles.js, npm run db:sync-roles).
// Threats are deliberately not in that YAML at all — they live in
// db/lib/threats.js, hand-assigned by a GM, and never appear in the
// player-facing picker. See docs/systemdocs/THREATS.md.
model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  intro       String   @default("")
  description String[] @default([])
  difficulty  String?

  // Authoring order within the faction, so the picker matches roles.yaml.
  sortOrder Int @default(0)

  factionId String
  faction   Faction @relation(fields: [factionId], references: [id])

  // Seat math, from the YAML's `multiple`/`weight` pair. Exactly one of
  // these three shapes applies, resolved by roleCapacity() in
  // db/lib/roleCapacity.js:
  //   isUnique  -> exactly 1 seat, forever (`multiple: false`)
  //   unlimited -> no cap at any scale (`weight: unlimited`)
  //   weight    -> round(weight * GameConfig.playerCount / 100)
  isUnique  Boolean @default(false)
  unlimited Boolean @default(false)
  weight    Int?

  // The starting package handed to a character who picks this role.
  startingResources   Int      @default(0)
  extraStartingPoints Int      @default(0)
  startingTagSlugs    String[] @default([])
  grantsLeader        Boolean  @default(false)
  grantsTreasurer     Boolean  @default(false)
  docElements         String[] @default([])

  // Whether picking this role needs the @Leader Whitelist Discord role. This
  // used to ride on grantsLeader, which conflated two unrelated things: the
  // Baron HAS to lead the Court, but "who may claim this seat" is a hosting
  // decision that has nothing to do with faction mechanics. Declared as
  // `whitelist:` in docs/roles.yaml. Gated by GameConfig.leaderWhitelistEnabled;
  // superadmins bypass. See docs/systemdocs/CHARACTERS.md §2.
  requiresWhitelist   Boolean  @default(false)

  // A seat that fixes the holder's gender rather than letting them choose:
  // Baron and Heir are MAN, Baroness and Successor are WOMAN. Null for every
  // ordinary role, which is nearly all of them. Declared as `gender:` in
  // docs/roles.yaml, so a future gendered seat needs no code — same posture
  // as grantsLeader/grantsTreasurer above.
  //
  // createCharacter stamps this over whatever the form posted, exactly as it
  // does for a dynasty member's last name; the disabled picker in the wizard
  // is only the hint.
  lockedGender Gender?

  // Where characters with this role begin. startingLocationId is what
  // creation writes; startingZoneId is its zone, kept for the readers that
  // group by zone. Derived by db/lib/syncRoles.js from `starting_location:`
  // in docs/roles.yaml, or — when absent — the first Location of
  // `starting_zone:`.
  startingZoneId     String?
  startingZone       Zone?     @relation("RoleStartingZone", fields: [startingZoneId], references: [id])
  startingLocationId String?
  startingLocation   Location? @relation("RoleStartingLocation", fields: [startingLocationId], references: [id])

  characters   Character[]
  reservations RoleReservation[]
  threatSpawns ThreatSpawn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factionId])
}

// A creation-wizard-in-progress hold on a Role seat. Without this, a player
// who picks a capacity-1 role at step 1 and spends ten minutes on the tag
// menu can lose the seat at Confirm with no warning — reported verbatim as
// "someone took my role". See db/lib/roleReservation.js for the seat math
// and CHARACTERS.md's Seat caps section.
//
// discordUserId is @unique so a player can hold exactly one seat at a time —
// reserving a second role is an upsert that releases the first. Expiry is
// swept lazily wherever taken counts are read; there is no cron job.
model RoleReservation {
  id            String   @id @default(cuid())
  discordUserId String   @unique
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([roleId, expiresAt])
}

// Master-sourced from docs/documents.yaml
// (db/lib/syncDocuments.js#syncDocumentsFromYaml, npm run db:sync-documents).
// `key` is the stable match key, and is what docs/roles.yaml's
// `doc_elements` lists point at. The sync is destructive: an entry no longer
// in the YAML has its row removed, same posture as syncLocations.
//
// Assignment is denormalized into string arrays rather than join tables. The
// catalog is ~30 rows, fully rebuilt from YAML on every sync, and read in one
// query per page view, so four relations would buy nothing. A document is
// ASSIGNED to a character if ANY of these matches: their role's docElements
// lists this key, they hold one of tagSlugs, their role is in roleSlugs,
// their faction is in factionSlugs, or flags names a Character boolean they
// have set.
model Document {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String @default("")

  // Everyone sees it, character or not — this is what the PUBLIC tab of
  // /documents renders, and the reason that page is readable before the
  // game opens.
  isPublic Boolean @default(false)

  // Master-GM-only. The SECRET tab of /documents shows these to GMs with
  // no zone assignment, so the master can reference threat briefs without
  // handing every zone-GM the full picture.
  isSecret Boolean @default(false)

  tagSlugs     String[] @default([])
  roleSlugs    String[] @default([])
  factionSlugs String[] @default([])
  // "leader" / "treasurer", read against Character.isLeader/isTreasurer,
  // which are booleans rather than tags (see docs/systemdocs/TAGS.md §6).
  flags        String[] @default([])

  // Authoring order from the YAML, so the gallery matches the file.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Turn {
  // Set once every pass in resolveNeeds() has completed for this turn.
  // A RESOLVED turn with this still null is one whose advance was claimed and
  // then died mid-flight — the process was killed, or a redeploy landed at
  // 04:00. advanceTurn() looks for exactly that and finishes the job instead
  // of silently skipping hunger and decay for the day, which is what it used
  // to do (the claim leaves no OPEN turn, so the rerun took the
  // nothing-to-resolve branch).
  needsResolvedAt DateTime?

  // Which passes have already been applied, as a JSON array of names. The
  // passes are NOT individually idempotent — re-running hunger charges upkeep
  // twice — so a resume has to know precisely which ones landed rather than
  // re-running the lot. A pass that throws is deliberately left unrecorded so
  // the next advance retries it.
  resolvedPasses Json?

  // The resume LEASE, which needsResolvedAt above cannot be: that one is the
  // completion stamp, written at the end, and a lease has to be taken at the
  // start.
  //
  // The resume branch used to be a plain findFirst, so the bot's 04:00 cron
  // and a GM clicking End turn on a crashed turn both matched the same row,
  // both read the same empty resolvedPasses, and both ran every outstanding
  // pass — hunger charged twice, Lifeweb decayed twice. resolvedPasses is not
  // a lock; last-write-wins cannot arbitrate. advanceTurn() now claims this
  // field with a conditional updateMany, the same compare-and-swap the normal
  // path does on status: "OPEN".
  //
  // Stale rather than permanent: a resume that dies holding the lease would
  // otherwise wedge the turn forever, so a claim older than the timeout can be
  // taken over.
  needsResumeClaimedAt DateTime?

  id         String     @id @default(cuid())
  number     Int        @unique
  phase      TurnPhase
  weather    Weather    @default(CLEAR)
  gameDate   DateTime
  status     TurnStatus @default(OPEN)
  startedAt  DateTime   @default(now())
  resolvedAt DateTime?

  actions        Action[]
  requests       Request[]
  stagedMessages StagedMessage[]
  stagedEffects  StagedEffect[]
  cavingRolls    CavingRoll[]
  offers         Offer[]
}

model Action {
  id                     String      @id @default(cuid())
  characterId            String
  character              Character   @relation(fields: [characterId], references: [id])
  turnId                 String
  turn                   Turn        @relation(fields: [turnId], references: [id])
  type                   ActionType?
  description            String
  zoneId                 String?
  zone                   Zone?       @relation(fields: [zoneId], references: [id])
  // WHERE this Move happened, stamped at filing time. zoneId above is not
  // enough: a free zone move (CARRY.md §2a) costs no Action, so a character
  // can file a Labor on the Factory floor and walk out before the turn closes,
  // and the payout runs at turn close. db/lib/moveEffects.js#refined reads
  // this to decide whether a Labor was a REFINING one; without it, it asked
  // where the character is standing NOW and paid for the wrong room.
  // Nullable, and readers fall back to the live location, so rows filed
  // before this existed still resolve.
  locationId             String?
  location               Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  resourceDelta          Int?
  // A range like "5-12", rolled at ⚜ confirm. @map keeps the original column
  // names: this used to hold dice notation ("1d6*2"), which the labor
  // shorthands and ranges replaced, so the field renamed but the SQL didn't.
  resourceRollExpression String?     @map("resourceDiceExpression")
  resourceRollValue      Int?        @map("resourceDiceRoll")
  diceRoll               Int?

  // The summed adjustment applied to a Gambit's d6 — Hunger only, see
  // db/lib/gambitModifier.js. Kept SEPARATE from diceRoll, which stores the raw
  // roll — otherwise a GM can't tell a modified 5 from a natural 5, and a
  // re-roll during adjudication would compound the modifier.
  diceModifier Int?
  status       ActionStatus @default(PENDING)

  // Routine vs Gambit (see MoveKind above) and the GM's spreadsheet-workflow
  // status — set during the DM submission flow (moveKind) and/or later
  // edited by a GM from the Moves adjudication popup (both, plus
  // moveReviewStatus itself).
  moveKind         MoveKind?
  moveReviewStatus MoveReviewStatus @default(OPEN)

  // Who resolved this Move and when. Request has carried these since the
  // rework; Moves need them too now that several GMs share the queue behind a
  // lock. The ID is stored, the Discord username is rendered.
  reviewedAt              DateTime?
  reviewedByDiscordUserId String?

  // Cooperative lock so two GMs don't adjudicate the same Move. Deliberately
  // NOT moveReviewStatus: a crashed browser lets lockExpiresAt lapse, where a
  // status write would strand the row "In Progress" forever. The Moves table
  // derives "In Progress" from a live lock.
  lockedByDiscordUserId String?
  lockExpiresAt         DateTime?

  // Snapshot of what was actually pushed onto the sheet — `{"resources":5}`
  // today. Written by the turn-end staged push (db/lib/stagedPush.js), which
  // also uses the SQL-NULL → `{}` transition as its per-row claim so a
  // resumed pass can never pay twice; the Default Move pass and travel stubs
  // stamp theirs at filing time. Reverts (deleteActionRestoringTurn) read
  // ONLY this and never re-derive from live state, the same
  // payload-vs-effect rule Request.effect follows (REQUESTS.md §2). JSON
  // rather than an Int so the push can grow past resources without a
  // migration. Null means nothing has been pushed yet.
  appliedEffects Json?

  // The Result box — the GM-facing canon of what happened, never auto-sent
  // (players are told through StagedMessages at the push; ADJUDICATION.md).
  resultMessage      String?
  // Machine markers only since the staged-arbitration rework — the "auto:*"
  // family (auto:labor, auto:zone_change, auto:silent_close…). No GM UI
  // renders or edits it any more.
  gmNotes            String?
  forumThreadId      String?
  confirmDmMessageId String?         @unique
  confirmedAt        DateTime?
  createdAt          DateTime        @default(now())
  stagedMessages     StagedMessage[]
  stagedEffects      StagedEffect[]

  // One Action per character per turn — the rule every writer already applies
  // by hand (db/lib/travel.js, interactionCreate's Move modal,
  // defaultMovePass's `acted` set, and the Dev Panel's spendTurn), each
  // via a non-transactional findFirst-then-create. At rollover, when everyone
  // acts at once and Discord retries interactions, that gap lets a
  // double-submit file two Actions and pay out twice. The database is the only
  // place the check can't be raced.
  @@unique([characterId, turnId])
  @@index([status, createdAt])
  @@index([characterId])
  @@index([turnId])
  // [status, createdAt] leads with status, so it cannot serve /gm/turns'
  // unfiltered `orderBy: { createdAt: "desc" }`. This one can.
  @@index([createdAt])
}

enum StagedMessageKind {
  PRIVATE
  PUBLIC
}

// A message a GM composed during adjudication that has NOT gone out yet.
// Nothing a GM stages reaches a player until the turn-end push
// (db/lib/stagedPush.js): PRIVATE rows fan out as DMs to their recipient
// characters' players, PUBLIC rows post to their zone's #summary channel.
// Until then every row is freely editable and deletable from the /gm/turns
// workspace; sentAt non-null is what freezes one.
model StagedMessage {
  id     String @id @default(cuid())
  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id])

  // The Move this message narrates, if any. SetNull rather than Cascade so
  // a Reject (which deletes the Action to give the turn back) detaches the
  // staged work instead of destroying it — the tray shows it "unattached"
  // with a delete affordance, and the GM decides.
  moveId String?
  move   Action? @relation(fields: [moveId], references: [id], onDelete: SetNull)

  // Same SetNull reasoning as moveId, for the Caving lens: a GM can stage
  // narration against a Caving Die roll of 1 exactly as against a Move.
  cavingRollId String?
  cavingRoll   CavingRoll? @relation(fields: [cavingRollId], references: [id], onDelete: SetNull)

  kind    StagedMessageKind
  content String

  // PUBLIC only, required: the zone whose #summary channel this posts to
  // (db/lib/stagedPush.js).
  zoneId String?
  zone   Zone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // Snapshot, no FK — same log-table convention as AuditLog's actor.
  createdByDiscordUserId String

  // Stamped by the push thunk after delivery is attempted. deliveryFailures
  // holds [{characterId, name, error}] for recipients whose DM bounced (or
  // {reason} for a PUBLIC row with no channel configured) — the audit row
  // staged_push_delivery_failed carries the same list.
  sentAt           DateTime?
  deliveryFailures Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients StagedMessageRecipient[]

  @@index([turnId])
  @@index([moveId])
}

// PRIVATE recipients, one row per recipient character. Cascade both ways:
// deleting the message drops its recipients, and a deleted character simply
// falls out of every recipient list (a DEAD one deliberately does not — "you
// died" is exactly what a staged message is for). A PRIVATE message whose
// recipients have all cascaded away is skipped at push and shown as
// "no recipients" in the tray.
model StagedMessageRecipient {
  id              String        @id @default(cuid())
  stagedMessageId String
  stagedMessage   StagedMessage @relation(fields: [stagedMessageId], references: [id], onDelete: Cascade)
  characterId     String
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([stagedMessageId, characterId])
  @@index([characterId])
}

// A mechanical adjustment a GM staged during adjudication — resources and/or
// tag ops against one target character — applied by the turn-end push, never
// before. payload is what the GM asked for; appliedEffect is what actually
// moved (the clamped resource delta, the tag ops that validated), the same
// payload-vs-effect rule Request.payload/effect and Action.appliedEffects
// follow. appliedAt doubles as the push pass's per-row claim, so a resumed
// pass can never apply one twice.
model StagedEffect {
  id     String @id @default(cuid())
  turnId String
  turn   Turn   @relation(fields: [turnId], references: [id])

  // Same SetNull reasoning as StagedMessage.moveId above.
  moveId String?
  move   Action? @relation(fields: [moveId], references: [id], onDelete: SetNull)

  // Same SetNull reasoning, for the Caving lens.
  cavingRollId String?
  cavingRoll   CavingRoll? @relation(fields: [cavingRollId], references: [id], onDelete: SetNull)

  // Nullable: a Room -> Room transfer has no character end. The filing rule
  // is "the character end of this row, if any" — the recipient when both
  // ends of a transfer are characters (they're the one who gets the DM),
  // null when neither is. Every other staged effect (resources/tagPoints/
  // tagOps/zone) always targets exactly one character, so this stays
  // required in practice for every payload shape but `transfer`.
  targetCharacterId String?
  targetCharacter   Character? @relation(fields: [targetCharacterId], references: [id], onDelete: Cascade)

  // Snapshot, no FK — log-table convention.
  createdByDiscordUserId String

  // A mass-apply ("Explosion Burns to these 4") writes one row per target
  // under a shared batchId, so the tray can show and delete it as one line.
  batchId String?

  // { resources?: Int, tagOps?: [op] } — the op shape is the Dev Panel's
  // (see db/lib/tagOps.js): {tagId, op: add|remove|patch, quantity?, source?,
  // expiry?, equipped?}. May also carry `zoneId?: String` — a staged
  // relocation, applied as a raw zone write at the push with the Discord
  // half handed to db/lib/zoneMove.js in the side-effect thunk. May instead
  // carry `transfer?: { from: {kind,id,name}, to: {kind,id,name}, amount }`
  // — mutually exclusive with `resources`; a row either mints/burns ⬢ from
  // nowhere or moves it between two named parties, never both.
  payload Json

  appliedAt     DateTime?
  appliedEffect Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([turnId])
  @@index([moveId])
  @@index([targetCharacterId])
  @@index([batchId])
}

enum DmDirection {
  INBOUND
  OUTBOUND
}

model DirectMessage {
  id            String      @id @default(cuid())
  discordUserId String
  direction     DmDirection
  content       String
  createdAt     DateTime    @default(now())

  // The GM who sent it; null = bot/system or inbound.
  authorDiscordUserId String?

  // gm_reply | gm_broadcast | gm_inspector | gm_dev | gm_slash |
  // move_unlock | staged_push | bot_auto | player | player_event. Plain
  // String on purpose — a PG enum would cost a migration per new value.
  source String?

  // Discord id of the sent message — the last chunk when postDmBatched had
  // to split it, which is the same message for anything under 2000 chars.
  discordMessageId String?

  // e.g. { attachments: [names] } or { embed: true }.
  meta Json?

  @@index([discordUserId, createdAt])
  @@index([createdAt])
  @@index([direction, discordUserId, createdAt]) // unread scans
}

// Per-GM read cursor on a player conversation. Unread = INBOUND
// DirectMessage rows newer than lastReadAt. Snapshot ids, no relations/FKs —
// same log-table convention as DirectMessage.
model ConversationRead {
  id                  String   @id @default(cuid())
  gmDiscordUserId     String
  playerDiscordUserId String
  lastReadAt          DateTime

  @@unique([gmDiscordUserId, playerDiscordUserId])
}

// Conversation-level state: advisory claiming, plus the "no reply needed"
// mark. Snapshot ids, no relations/FKs — same log-table convention as
// DirectMessage.
model ConversationMeta {
  id                     String    @id @default(cuid())
  playerDiscordUserId    String    @unique
  claimedByDiscordUserId String?
  claimedAt              DateTime?
  // When a GM marked this conversation as needing no reply. Desk-wide, not
  // per-GM, same as the claim above. It self-expires: the rail only counts it
  // as handled while it is at or after the conversation's last message, so the
  // next inbound DM puts the row back in the awaiting pile with no cleanup.
  handledAt              DateTime?
  // When a GM muted this conversation. Desk-side only — nothing about the
  // bot's behaviour toward the player changes, and their DMs still arrive.
  // A muted row leaves the rail (behind a "Show muted" toggle), renders
  // greyed when shown, and stops counting toward unread/awaiting. Unlike
  // handledAt above this does NOT expire: it holds until a GM unmutes.
  mutedAt                DateTime?
}

// A player's personal note on a message in a Location channel — created by
// reacting ⭐ to any proxied message (bot/src/events/messageReactionAdd.js);
// the bot strips the reaction back off immediately, so the note's presence
// on /notes is the only lasting trace, not the Discord reaction itself. Each
// (message, starrer) pair gets its own row, since a note is personal to
// whoever starred it — not a shared/aggregate count.
model Note {
  id               String     @id @default(cuid())
  discordMessageId String
  discordChannelId String
  characterId      String?
  character        Character? @relation(fields: [characterId], references: [id])
  characterName    String
  zoneId           String?
  zone             Zone?      @relation(fields: [zoneId], references: [id])
  content          String
  sentAt           DateTime
  discordUserId    String
  createdAt        DateTime   @default(now())

  @@unique([discordMessageId, discordUserId])
  @@index([discordUserId])
  @@index([zoneId])
}

// A player's personal journal entry — the /notes page's Journal tab, distinct
// from Note (a starred Discord message) above. Keyed on discordUserId only,
// same reasoning as Note: it is a player's own writing, never
// a shared or GM-visible surface. `body` may embed `{char:<characterId>}`
// mention tokens (web/app/components/richTokens.js); there is no FK to
// Character on purpose — a deleted or renamed character just degrades the
// mention to a letter-plaque / raw token, the token pipeline's existing
// behaviour for an unresolvable reference, rather than cascading a delete
// into someone's private writing.
model JournalEntry {
  id            String   @id @default(cuid())
  discordUserId String
  title         String
  body          String
  pinned        Boolean  @default(false)
  turnNumber    Int?
  labels        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordUserId])
}

// A consent handshake between two characters, alive for one turn
// (docs/systemdocs/LESSONS.md). LESSON pairs a teacher and a learner around
// one skill and, once accepted, owns the two Moves it filed; BIND asks the
// target's leave before BIND_CHARACTER fires. Character ends are snapshot
// ids without FKs, the log-table convention — a dead character's offers stay
// readable. No DM message id is stored: the bot strips the buttons with
// interaction.update() on click, and a stale button just says the offer's
// gone.
enum OfferKind {
  LESSON
  BIND
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  RESOLVED
}

model Offer {
  id     String      @id @default(cuid())
  kind   OfferKind
  status OfferStatus @default(PENDING)
  turnId String
  turn   Turn        @relation(fields: [turnId], references: [id])

  // Who pressed the button on the web, and who gets the DM.
  initiatorId String
  responderId String

  // LESSON only. One of them is the initiator.
  teacherId String?
  learnerId String?
  tagId     String?
  tag       Tag?    @relation(fields: [tagId], references: [id])
  // 5, or 4 for a fighting skill under a Drill Instructor. Fixed at accept.
  threshold Int?

  // The two Moves acceptLesson filed. The learner's is a Gambit the lesson
  // pass resolves; the teacher's is a Routine a Lecturer can share across
  // up to three learners.
  learnerActionId String? @unique
  teacherActionId String?

  // { diceRoll, diceModifier, total, succeeded, gmDecided }
  outcome Json?
  // The web dialog's reason field, copied onto the BIND_CHARACTER request.
  reason  String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  resolvedAt  DateTime?

  @@index([status, turnId])
  @@index([responderId, status])
  @@index([initiatorId, status])
  @@index([teacherActionId])
}

// A multi-turn craft in progress (docs/systemdocs/CRAFTING.md). A table, not
// an "in progress" pseudo-tag: it has a counter, a payer and a link to the
// Move that last advanced it, none of which fit CharacterTag — and a tag
// would show on 🔍 inspect and count toward carry.
enum CraftStatus {
  ACTIVE
  DONE
  CANCELLED
}

model CraftProject {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id])
  quantity    Int       @default(1)
  turnsNeeded Int
  turnsDone   Int       @default(0)

  // Charged when the project starts, never refunded on cancel. The payer is
  // a party key ("character:<id>" | "room:<id>") snapshot so Undo can send it
  // back.
  resourcesCost Int     @default(0)
  payerKey      String?
  payerName     String?

  status        CraftStatus @default(ACTIVE)
  startedTurnId String
  // The turn whose Routine last advanced it — one advance per turn.
  lastTurnId    String?
  // The ADD_TAG Request written on completion.
  requestId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
}

model AuditLog {
  id                 String     @id @default(cuid())
  actorDiscordUserId String
  actionType         String
  targetCharacterId  String?
  targetCharacter    Character? @relation(fields: [targetCharacterId], references: [id])
  details            Json?

  // Only populated by Request-backed entries (see RequestType) — the
  // player's own words, surfaced as a column on /gm/audit.
  reason    String?
  createdAt DateTime @default(now())

  @@index([actionType])
  @@index([actorDiscordUserId])
  // /gm/audit's default view sorts the whole table by createdAt with no
  // filter, and runs a count() beside it. Neither index above can serve that.
  @@index([createdAt])
  @@index([targetCharacterId])
}

enum CavingRollKind {
  TROUBLE
  QUIET
  FIND
}

// Which of the two triggers in db/lib/cavingPass.js produced a roll. The
// turn-start pass rolls for everyone already standing in the Depths when the
// new turn opens; an arrival (travel, a GM relocation, fast travel) rolls
// again for whoever just walked in. See the @@unique below.
enum CavingTrigger {
  TURN_START
  ARRIVAL
}

// Up to two rolls per character per turn while standing in a CAVE_LEVEL zone —
// one for TURN_START, one for ARRIVAL — rolled by db/lib/cavingPass.js. A
// character already in the Depths when the turn opens gets the pass's roll; one
// who arrives mid-turn gets a bonus roll on top. The @@unique below is what
// caps each trigger at one hit per character per turn, so neither a retried
// pass nor a character bounced in and out (free travel, a GM's Bulk Move) can
// farm more than the two.
//
// Shaped like a Move on purpose — it is adjudicated the same way, on the
// same /gm/turns desk, with the same staging attachments. See
// docs/systemdocs/CAVING.md.
model CavingRoll {
  id          String    @id @default(cuid())
  turnId      String
  turn        Turn      @relation(fields: [turnId], references: [id])
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // Which trigger produced this roll. Load-bearing in the @@unique below.
  trigger CavingTrigger @default(TURN_START)

  // The presence zone the character stood in when it rolled. Snapshot,
  // because they may have moved since.
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  die  Int // 1-6, flat — no Gambit modifier
  kind CavingRollKind

  // Set on a FIND only: the tier drawn (db/lib/cavingLoot.js) and the tag
  // granted, so the lens can show "Rare -> Spyglass" without a join through
  // lootRequest.
  lootTier  String?
  lootTagId String?
  lootTag   Tag?    @relation(fields: [lootTagId], references: [id])

  // The PASSED-by-default Request the loot grant was filed as (type
  // CAVING_LOOT), so a GM's Undo goes through the ordinary request handler
  // in web/lib/requestEffects.js rather than a bespoke path.
  lootRequestId String?  @unique
  lootRequest   Request? @relation(fields: [lootRequestId], references: [id], onDelete: SetNull)

  // Only a TROUBLE row is ever left unresolved — QUIET and FIND are stamped
  // at creation, which is what keeps the Caving lens showing the 1s instead
  // of every roll anyone made.
  resolvedAt              DateTime?
  resolvedByDiscordUserId String?
  gmNotes                 String?

  createdAt DateTime @default(now())

  stagedMessages StagedMessage[]
  stagedEffects  StagedEffect[]

  @@unique([characterId, turnId, trigger])
  @@index([turnId, resolvedAt])
}

// One row per player action that took effect without GM approval. `payload`
// is what the player asked for; `effect` is what was actually applied, and is
// the ONLY thing Undo reads. That split is load-bearing: reversing a request
// by re-deriving it from current state would corrupt as soon as a GM edits an
// amount or the character transacts again in the meantime.
model Request {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id])
  turnId      String?
  turn        Turn?         @relation(fields: [turnId], references: [id])
  type        RequestType
  status      RequestStatus @default(PASSED)
  reason      String
  payload     Json
  effect      Json
  gmNotes     String?

  reviewedAt              DateTime?
  reviewedByDiscordUserId String?

  createdAt DateTime @default(now())

  // Back half of CavingRoll.lootRequestId — a system-filed CAVING_LOOT
  // request points back at the roll that created it.
  cavingRoll CavingRoll?

  @@index([status, createdAt])
  @@index([characterId])
  // Same reason as Action above: /gm/turns sorts unfiltered by createdAt.
  @@index([createdAt])
}

// One letter carried by a bird (docs/systemdocs/BIRD.md). Live state, not a
// log: the reply window is read off this row every time someone presses the
// Reply button in their DMs, and the failure pass sweeps it at turn close.
//
// Every party is stored as a SNAPSHOT — id, name and Discord id copied at send
// time, with no foreign key — for the reason ARCHITECTURE.md gives for the log
// tables. Two extra ones apply here. The reply handler needs the sender's
// Discord id and nothing else, so a snapshot lets it answer without a join at
// all; and a bird outlives its people, so a letter sent to someone who is
// deleted or wiped afterwards must still read back correctly on the GM desk.
model BirdMessage {
  id String @id @default(cuid())

  senderId               String
  senderName             String
  senderDiscordUserId    String?
  recipientId            String
  recipientName          String
  recipientDiscordUserId String?

  // Where the sender GUESSED the recipient was standing. The whole mechanic is
  // that this can be wrong, so it is recorded whether or not it matched.
  guessedZoneId   String
  guessedZoneName String

  // The letter the bird actually carried, and the whole of what a Bird send is
  // now: you pick a paper you are HOLDING (docs/systemdocs/PAPERWORK.md). Null
  // only on rows written before the paperwork rework.
  //
  // Not a relation, and deliberately: the paper can be sealed, torn up, eaten
  // or wiped, and this row is the GM's record that a letter went. It holds the
  // id so the desk can still find the tag while it exists.
  tagId   String?
  tagName String?

  // A snapshot of the text at send time, so the desk can read what went even
  // after the paper is gone or resealed. Null when the letter went out sealed
  // — the bird did not open it either.
  body String?

  // False means the guess missed, or the recipient was dead. The sender is not
  // told until the next turn closes: an instant "no" would turn this into a
  // once-a-day scout for where somebody is standing, which is exactly what the
  // guess is supposed to cost.
  delivered Boolean @default(false)

  // Null on a miss. On a hit, the turn the letter landed in.
  arrivalTurnId String?

  // Turn.number of the LAST turn a reply is accepted in — the arrival turn
  // plus one. A letter sent five minutes before a turn closes would otherwise
  // be unanswerable in practice, which reads as a bug rather than as a rule.
  replyDeadlineTurn Int?

  // Stamped by db/lib/birdPass.js when the "wasn't delivered" DM is handed to
  // the side-effect thunk, so a resumed close cannot send it twice.
  failureNotifiedAt DateTime?

  // One reply, never a chain. Once repliedAt is set the button is spent.
  repliedAt DateTime?
  replyBody String?

  createdAt DateTime @default(now())

  // The failure pass's own query: undelivered and not yet notified.
  @@index([delivered, failureNotifiedAt])
  @@index([recipientId])
  @@index([senderId])
}

// A character's self-set goal, worth 1-5 Tag Points on fulfillment. At most
// one ACTIVE row per character (enforced in the server action, not the
// schema, since the constraint is "one ACTIVE" rather than "one row").
// endedTurnNumber drives the one-turn cooldown after a cancel or a fulfill.
// Master-sourced from docs/desires.yaml (db/lib/syncDesires.js,
// npm run db:sync-desires). `slug` is the stable match key. Reconciled with
// SOFT RETIRE rather than deletion — see the sync section.
model DesireTemplate {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  description          String?
  // 1|2|3|4|5|7. Doubles as the default Tag Point award AND the per-desire
  // cooldown in turns (cooldownTurns overrides it). Whitelisted in the sync,
  // not the schema — 6 is deliberately absent.
  tier                 Int
  families             String[] @default([])
  // Defaults true for tier 7 in the sync; an explicit YAML value wins.
  onceEver             Boolean  @default(false)
  // Per-entry override of the tier-derived cooldown (used by
  // charitable-act-devoted = 3, use-a-censer = 5). Null means "use tier".
  cooldownTurns        Int?
  // Real relations, not slug arrays, so db:prune-tags can see the reference
  // and refuse to delete a Tag a live desire depends on.
  requiresAnyTags      Tag[]    @relation("DesireRequiresAnyTag")
  requiresNotTags      Tag[]    @relation("DesireForbidsTag")
  // ALL of these, not any (docs/desires.yaml `requires.allTags`). A real
  // relation for the same reason as the two above. Always AND — never joined
  // by requiresAnyOf, since an "all" list combined with OR is meaningless.
  requiresAllTags      Tag[]    @relation("DesireRequiresAllTag")
  // Slug arrays, not FKs: db:sync-roles prunes Role rows and an FK would
  // block that (Document.roleSlugs precedent).
  requiresAnyRoleSlugs String[] @default([])
  requiresNotRoleSlugs String[] @default([])
  // When true, requiresAnyTags and requiresAnyRoleSlugs are satisfied by
  // EITHER one, not both (docs/desires.yaml `requires.combine: or`). Lets a
  // tag open a Desire that a role also opens, without the tag purchase being
  // dead weight to everyone outside that role. notTags/notRoles stay AND
  // regardless — a forbidden pairing is never something an OR should open.
  requiresAnyOf        Boolean  @default(false)
  // Absent from docs/desires.yaml: hidden from every picker, existing
  // instances keep running.
  retired              Boolean  @default(false)
  sortOrder            Int      @default(0)

  desires Desire[]
}

model Desire {
  id              String       @id @default(cuid())
  characterId     String
  character       Character    @relation(fields: [characterId], references: [id])
  // STAYS non-null: a snapshot of template.name at claim time, so every
  // existing reader (requestEffects.js, the bot's 🔍/⚜️ embeds, the archive,
  // auditNarrative.js…) stays untouched by the catalog rework.
  text            String
  // The awarded number — a GM re-score writes it, so it can diverge from
  // template.tier. The COOLDOWN reads template.tier, never points.
  points          Int
  status          DesireStatus @default(FULFILLED)
  // A claim stamps BOTH with the open turn — the row is born ended. They stay
  // two columns because pre-rework rows carry a real gap between them.
  setTurnNumber   Int?
  // null means "does not lock its slot": a revoked or undone claim.
  endedTurnNumber Int?

  // Nullable ON PURPOSE AND FOREVER: grandfathers freeform rows and GM
  // off-catalog desires.
  templateId String?
  template   DesireTemplate? @relation(fields: [templateId], references: [id])
  // Which of GameConfig.desireSlots this occupies; grandfathered rows
  // backfilled to 0.
  slotIndex  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId, status])
  @@index([characterId, templateId, status]) // the per-desire cooldown query
}

// The game's transcript, and the backing store for /archive.
//
// Written at SEND time (db/lib/archive.js, called from the two proxy paths),
// not reconstructed at Dawn. The old dawnWipe.js archived by reading messages
// back out of Discord and re-posting them into one #archive channel — ~850
// sequential posts down a single ~1 msg/sec lane on a busy turn, which was the
// most expensive thing the bot did and grew with player count. It also had to
// guess: the character was matched by *current* name (so a rename
// mis-attributed everything they'd ever said) and the turn was inferred by
// comparing timestamps against Turn.gameDate. Recording at write time makes
// both exact and reduces the wipe to deletes.
//
// The id columns are deliberately NOT foreign keys, same posture as
// AuditLog's snapshot fields. Two things in this codebase
// destructively delete the rows they'd point at: syncZonesFromYaml removes
// any Zone dropped from the YAML, and wipeGameData clears Characters. A
// real relation would either take the transcript with it or fail on FK
// ordering (which Restart Game has already been bitten by once). Plain indexed
// ids plus name snapshots survive both, and the snapshot is the more correct
// record anyway — who someone was known as *then*.
model ArchiveEntry {
  id   String      @id @default(cuid())
  kind ArchiveKind @default(MESSAGE)

  // Stamped from the open turn as the row is written.
  turnNumber Int?
  turnPhase  TurnPhase?
  sentAt     DateTime   @default(now())

  zoneId        String?
  zoneName      String?
  characterId   String?
  characterName String?

  // Non-null only for a message sent through /conceal. Both halves are kept:
  // the panel renders "Young Man (Sir Alder)", so the alias is what was seen
  // and characterName is who it actually was.
  concealedAlias String?

  content String

  // How ✏️ and ❌ find this row again to update or remove it. Null for system
  // events, which have no Discord message behind them.
  discordMessageId String? @unique

  // summary | public | private | watch | intercom — lets the panel keep a
  // zone's summary channel apart from its forum scenes. ("plain" in rows
  // written before the zone rework.)
  channelKind String?

  // Forum post / thread title, so a scene reads as one unit rather than
  // scattered lines under its location.
  threadName String?

  // The Discord channel the message was posted in — the THREAD's own id when
  // it was said inside a thread, because that is what a jump link's channel
  // slot needs. A plain snapshot, not an FK (same posture as every id column
  // here): Locations are destructively resynced and a rework is coming.
  discordChannelId String?

  createdAt DateTime @default(now())

  // NOTE: ArchiveEntry also carries a trigram GIN index on `content`
  // (ArchiveEntry_content_trgm_idx), created by raw SQL in the
  // 20260825020000_launch_hardening_indexes migration. Prisma's schema
  // language cannot express an operator-class index, so it is invisible here
  // and `prisma migrate diff` will not know about it — do not "clean it up"
  // if a future diff reports it as drift.
  //
  // [sentAt, id] not [sentAt]: /archive orders by both, the id being the
  // tiebreaker that keeps pagination stable across equal millisecond
  // timestamps. On sentAt alone Postgres still has to sort for the tiebreak.
  @@index([sentAt, id])
  @@index([turnNumber])
  @@index([kind])
  @@index([zoneId, sentAt])
  @@index([characterId, sentAt])
  @@index([discordChannelId, sentAt])
}

// A GM's own notes about a player, on the player desk's dossier.
//
// NOT to be confused with Note above, which is a PLAYER's personal list of
// messages they starred with a reaction in a location channel. That one is
// keyed to the reacting user and is theirs; this one is GM-only and is about
// somebody else.
//
// Append-only short notes with attribution rather than one shared editable
// field, because five GMs editing a single textarea race each other and the
// loser's paragraph vanishes with no trace of who ate it. A GM may delete
// their own.
//
// A real relation with a cascade, unlike the log tables (DirectMessage,
// AuditLog) that store snapshot columns on purpose: a note is live data ABOUT
// a character rather than a record of something that happened, and it has no
// meaning once the character is gone.
model GmCharacterNote {
  id                  String    @id @default(cuid())
  characterId         String
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  authorDiscordUserId String
  content             String
  createdAt           DateTime  @default(now())

  @@index([characterId, createdAt])
}

// A threat seat offered to somebody who has no character yet: the GM presses
// SPAWN on /gm/dev?s=assignments, this row is written, and the target gets a
// DM carrying Accept / Decline. Accepting creates the character
// (db/lib/threatSpawn.js). See docs/systemdocs/THREATS.md.
//
// The offer is a row rather than state on a DM because the DM is Discord's and
// can be deleted: the row is what says an offer is live, what seat and role it
// was for, and -- once answered -- what became of it.
model ThreatSpawn {
  id String @id @default(cuid())

  // The target. Not a Character relation on purpose: the whole point is that
  // they have no character yet, and after accepting they own the one below.
  discordUserId String

  // A slug in db/lib/threats.js, not a table -- the catalog is code, same
  // posture as antagonistOptIns above.
  threatSlug String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Null only for a role with no starting location; every offer the UI writes
  // names one.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  status ThreatSpawnStatus @default(PENDING)

  // The GM who offered. A Discord user id rather than a relation, same as
  // AuditLog.actorDiscordUserId -- there is no user table.
  offeredBy String

  // Set on accept. Unique, so one offer can never mint two characters.
  characterId String? @unique

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // One live offer per player is enforced by a PARTIAL unique index
  // (WHERE status = 'PENDING') that lives only in the migration SQL, because
  // Prisma's schema language cannot express one. `prisma migrate diff` will
  // propose dropping it -- decline, same as FactionApplication_pending_unique.
  @@index([discordUserId, status])
  @@index([status])
}

enum ThreatSpawnStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}
