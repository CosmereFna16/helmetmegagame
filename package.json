{
  "name": "lifeweb",
  "private": true,
  "workspaces": [
    "bot",
    "web",
    "db"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:bot": "npm run dev --workspace=bot",
    "push": "bash -c 'git add -A && (git diff --cached --quiet || git commit -m \"${1:-wip}\") && git push -u origin master' --",
    "redeploy": "railway redeploy -s web --from-source -y && railway redeploy -s '@lifeweb/bot' --from-source -y",
    "deploy": "git push origin master && ./migrate.sh && npm run redeploy",
    "db:generate": "npm run generate --workspace=db",
    "db:migrate": "npm run migrate --workspace=db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=db",
    "db:backfill-roles": "node db/prisma/backfill-roles.js",
    "db:backfill-name-parts": "node db/prisma/backfill-name-parts.js",
    "db:backfill-member-access": "node db/prisma/backfill-member-access.js",
    "db:backfill-persistent-tag": "node db/prisma/backfill-persistent-tag.js",
    "db:backfill-tag-rework": "node db/prisma/backfill-tag-rework.js",
    "db:backfill-gm-permissions": "node db/prisma/backfill-gm-permissions.js",
    "db:backfill-spectator-access": "node db/prisma/backfill-spectator-access.js",
    "db:backfill-tupper-attachment-restriction": "node db/prisma/backfill-tupper-attachment-restriction.js",
    "db:prune-orphan-categories": "node db/prisma/prune-orphan-categories.js",
    "map:check": "node db/prisma/check-map.js",
    "db:sync-locations": "node db/prisma/sync-locations.js",
    "db:sync-tags": "node db/prisma/sync-tags.js",
    "db:sync-roles": "node db/prisma/sync-roles.js",
    "db:sync-documents": "node db/prisma/sync-documents.js",
    "db:sync-narrowcast-channels": "node db/prisma/sync-narrowcast-channels.js",
    "db:rebuild-info-channel": "node db/prisma/rebuild-info-channel.js"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
